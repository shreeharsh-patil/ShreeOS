# ---------------------------------------------------------------------------
# Phase 2 -- service-management stack prerequisites and core userspace
#
# systemd and udev cannot be built without the first set: find/xargs at
# build time, libcap for capability handling, kmod for module loading,
# libseccomp for sandboxing, PAM + shadow for login, dbus for the system
# bus. The second set adds the diagnostics/transfer tools a desktop user
# and the installer both need.
#
# Every URL below was resolved against live upstream hosts on 2026-09-28
# (several previously listed mirrors 404) and every checksum was computed
# from the actual downloaded tarball -- none are placeholders. Verify with:
#   bash base-system/scripts/update-pins.sh --check
# ---------------------------------------------------------------------------

# libcap -- POSIX capability utilities. udev and systemd require it.
libcap	2.70	https://www.kernel.org/pub/linux/libs/security/linux-privs/libcap2/libcap-2.70.tar.gz	d3b777ed413c9fafface03b917e171854709b5e4be38dbfb9219aaf7dfd4eea6

# attr/libattr + acl -- extended attributes and POSIX ACLs on the target
# filesystem; systemd's ACL access-control path needs libacl.
attr	2.5.2	https://download-mirror.savannah.gnu.org/releases/attr/attr-2.5.2.tar.gz	39bf67452fa41d0948c2197601053f48b3d78a029389734332a6309a680c6c87
acl	2.3.2	https://download.savannah.nongnu.org/releases/acl/acl-2.3.2.tar.gz	5f2bdbad629707aa7d85c623f994aa8a1d2dec55a73de5205bac0bf6058a2f7c

# libseccomp -- system call filtering for sandboxed services.
libseccomp	2.6.0	https://github.com/seccomp/libseccomp/releases/download/v2.6.0/libseccomp-2.6.0.tar.gz	83b6085232d1588c379dc9b9cae47bb37407cf262e6e74993c61ba72d2a784dc

