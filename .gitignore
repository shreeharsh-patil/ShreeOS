# Build scratch space — never committed, always reproducible from scripts
/build/
/out/

# Downloaded upstream sources (large, re-fetchable, checksum-verified)
*.tar.gz
*.tar.xz
*.tar.bz2
*.tar.zst

# Editor/OS cruft
.vscode/
.idea/
*.swp
.DS_Store

# AI / planning artifacts (not part of the distro)
.planning/
AGENTS.md
opencode.json
gemini-extension.json
IMPLEMENTATION_PLAN.md

# Logs
*.log

# Binaries and object files
*.o
*.exe
*.a
*.so
lpm
lpm-build
test-manifest
/hardware/shreed
/hardware/shreedctl
/hardware/tests/shreed-test-daemon
/hardware/tests/test-collectors
/hardware/tests/test-shreed
/init/src/init
/init/src/initctl
/init/src/shree-auth
/init/tests/test-*

# Cryptographic private keys (strictly kept outside git)
*.key
*.pem
*.sec
private/
