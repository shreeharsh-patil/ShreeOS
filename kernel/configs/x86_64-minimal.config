# kernel/configs/x86_64-minimal.config
# Minimal Kconfig overrides for QEMU x86_64 boot testing.
#
# Usage: Applied on top of `make ARCH=x86_64 defconfig` via
#   scripts/kconfig/merge_config.sh -m .config <this-file>
#
# Target: Boot under qemu-system-x86_64 with:
#   - virtio block device (rootfs)
#   - virtio net device
#   - ext4 root filesystem
#   - serial console (ttyS0)
#   - embedded initramfs for boot testing

# --- Architecture ---
CONFIG_64BIT=y

# --- Initramfs ---
CONFIG_BLK_DEV_INITRD=y
# CONFIG_INITRAMFS_SOURCE is set dynamically by build-kernel.sh

# --- PCI (required for virtio-pci) ---
CONFIG_PCI=y
CONFIG_PCI_MSI=y

# --- Block layer ---
CONFIG_BLOCK=y

# --- Virtio drivers (QEMU) ---
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BALLOON=y

# --- Serial console ---
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_CORE=y
CONFIG_SERIAL_CORE_CONSOLE=y
CONFIG_HVC_DRIVER=y

# --- Filesystems ---
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# --- Networking (minimal) ---
CONFIG_NET=y
CONFIG_INET=y
CONFIG_NETDEVICES=y

# --- Executable formats ---
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# --- Kernel features ---
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_EARLY_PRINTK=y
CONFIG_EARLY_PRINTK_DBGP=y
