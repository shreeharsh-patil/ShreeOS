#!/bin/sh
# /etc/X11/xinit/xinitrc — X session startup for ShreeOS

# Wallpaper
if [ -f /usr/share/wallpapers/shreeos-wallpaper.png ]; then
  xwallpaper --zoom /usr/share/wallpapers/shreeos-wallpaper.png &
fi

# Keyboard
setxkbmap us &

# Status bar
if [ -x /usr/bin/dwm-statusbar.sh ]; then
  /usr/bin/dwm-statusbar.sh &
fi

# Start window manager
exec dwm
