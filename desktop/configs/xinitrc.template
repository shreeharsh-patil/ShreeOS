#!/bin/sh
# /etc/X11/xinit/xinitrc — ShreeOS desktop session orchestrator

SESSION_PIDS=""

track_pid() {
  SESSION_PIDS="$SESSION_PIDS $1"
}

cleanup_session() {
  trap - EXIT INT TERM
  for pid in $SESSION_PIDS; do
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then kill -15 "$pid" 2>/dev/null || true; fi
  done
  sleep 1
  for pid in $SESSION_PIDS; do
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then kill -9 "$pid" 2>/dev/null || true; fi
  done
}
trap cleanup_session EXIT INT TERM

if command -v xrdb >/dev/null 2>&1; then
  if [ -f /etc/X11/Xresources ]; then xrdb -merge /etc/X11/Xresources
  elif [ -f "$HOME/.Xresources" ]; then xrdb -merge "$HOME/.Xresources"
  fi
fi

if [ -f /usr/share/wallpapers/shreeos-wallpaper.svg ]; then
  if command -v xwallpaper >/dev/null 2>&1; then xwallpaper --zoom /usr/share/wallpapers/shreeos-wallpaper.svg & track_pid $!
  elif command -v feh >/dev/null 2>&1; then feh --bg-fill /usr/share/wallpapers/shreeos-wallpaper.svg & track_pid $!
  fi
elif [ -f /usr/share/wallpapers/shreeos-wallpaper.png ] && command -v xwallpaper >/dev/null 2>&1; then
  xwallpaper --zoom /usr/share/wallpapers/shreeos-wallpaper.png & track_pid $!
fi

command -v setxkbmap >/dev/null 2>&1 && setxkbmap us >/dev/null 2>&1 &
if command -v xset >/dev/null 2>&1; then xset s 600 dpms 600 900 1200 >/dev/null 2>&1 & fi

if command -v picom >/dev/null 2>&1; then
  if command -v glxinfo >/dev/null 2>&1 && glxinfo 2>/dev/null | grep -iqE "llvmpipe|softpipe|swrast"; then
    picom --backend xrender --no-blur &
  else
    picom --config /etc/X11/picom.conf &
  fi
  track_pid $!
fi

if command -v shree-theme >/dev/null 2>&1; then
  shree-theme refresh >/dev/null 2>&1 || true
  shree-theme watch >/dev/null 2>&1 & track_pid $!
fi

if [ -f "$HOME/.config/shreeos/clipboard.conf" ] && grep -q "ENABLED=true" "$HOME/.config/shreeos/clipboard.conf" 2>/dev/null; then
  if command -v shree-clipboard >/dev/null 2>&1; then shree-clipboard --daemon & track_pid $!; fi
fi

if command -v shree-topbar >/dev/null 2>&1; then shree-topbar & track_pid $!
elif [ -x /usr/bin/shree-topbar.sh ]; then /usr/bin/shree-topbar.sh & track_pid $!
fi

if command -v shree-dock-ui >/dev/null 2>&1; then shree-dock-ui & track_pid $!
elif command -v shree-dock >/dev/null 2>&1; then shree-dock --daemon & track_pid $!
elif [ -x /usr/bin/shree-dock.sh ]; then /usr/bin/shree-dock.sh --daemon & track_pid $!
fi

if command -v shree-onboarding >/dev/null 2>&1; then shree-onboarding & track_pid $!
elif [ -x /usr/bin/shree-onboarding.sh ]; then /usr/bin/shree-onboarding.sh & track_pid $!
fi

if ! command -v dwm >/dev/null 2>&1; then
  echo "ShreeOS desktop: dwm is missing" >&2
  exit 1
fi

dwm &
WM_PID=$!
wait "$WM_PID"
