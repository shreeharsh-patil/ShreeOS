# dwm configuration: keybindings & visual parameters
# Installed to /etc/dwm/config.h during build
# MODKEY = Super (Windows / Command key)

MODKEY=Mod4

# Universal Spotlight Search: Super + Space
[Mod4]=space -> shree-launcher

# Global Command Palette: Super + K
[Mod4]=k -> shree-cmdpalette

# Clipboard History: Super + V
[Mod4]=v -> shree-clipboard

# Native File Manager: Super + E
[Mod4]=e -> shree-files

# Terminal: Super + Return
[Mod4]=Return -> st

# Fullscreen Screenshot: PrintScreen
[]=Print -> shree-screenshot full

# Region Screenshot: Super + Shift + 4
[Mod4|Shift]=4 -> shree-screenshot select

# Close active window: Super + Q
[Mod4]=q -> killclient

# Switch to workspace N: Super + 1-4
[Mod4]=1-4 -> view

# Toggle bar: Super + B
[Mod4]=b -> togglebar

# Window Snapping:
# Super + Left  -> shrink master
# Super + Right -> expand master
# Super + Up    -> fullscreen / monocle
# Super + Down  -> standard tiling

# Quit dwm session: Super + Shift + Q
[Mod4|Shift]=q -> quit
