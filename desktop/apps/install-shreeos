#!/usr/bin/env bash
# install-shreeos — launch the guided ShreeOS installer from a live desktop.
set -Eeuo pipefail

show_error() {
  local message="$1"
  printf '%s\n' "$message" >&2
  if [ -n "${DISPLAY:-}" ] && command -v zenity >/dev/null 2>&1; then
    zenity --error --title='Install ShreeOS' --width=420 --text="$message" --ok-label='Close' >/dev/null 2>&1 || true
  fi
}

if [ "$(id -u)" -ne 0 ]; then
  if command -v sudo >/dev/null 2>&1; then
    exec sudo "$0" "$@"
  fi
  show_error "Install ShreeOS requires root privileges."
  exit 1
fi

for candidate in \
  /usr/lib/shreeos-installer/installer-tui.sh \
  /opt/shreeos-installer/installer-tui.sh; do
  if [ -x "$candidate" ]; then
    export SHREEOS_INSTALLER_ROOT="$(dirname "$candidate")"
    exec "$candidate" "$@"
  fi
done

show_error $'The live installer payload is not installed on this image.\nRebuild the desktop ISO and make sure the installer stage passes verification.'
exit 1
