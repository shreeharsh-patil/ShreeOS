#!/usr/bin/env bash
# desktop/apps/shree-settings — ShreeOS Master System Settings Application
#
# Dense, organized category navigation with direct backend system hooks
# for appearance, wallpapers, displays, network, bluetooth, sound, storage, updates.

set -euo pipefail

apply_wallpaper() {
  local wp="$1"
  if [ -f "$wp" ]; then
    if command -v xwallpaper >/dev/null 2>&1; then
      xwallpaper --zoom "$wp"
    elif command -v feh >/dev/null 2>&1; then
      feh --bg-fill "$wp"
    fi
    mkdir -p "${HOME}/.config/shreeos"
    echo "WALLPAPER=${wp}" > "${HOME}/.config/shreeos/wallpaper.conf"
    shree-notify "Wallpaper Updated" "Applied $(basename "$wp")" --app="Settings"
  fi
}

handle_appearance() {
  local cur
  cur=$(shree-theme status 2>/dev/null || echo "dark")
  local choice
  choice=$(printf "Dark Mode (Currently %s)\nLight Mode\nAutomatic (Sunset to Sunrise)\nToggle Theme Now\nChange Wallpaper\nAdjust Transparency & Blur" "$cur" | dmenu -p "Appearance Settings" -l 6 -c)
  [ -z "$choice" ] && return

  case "$choice" in
    "Dark Mode"*)  shree-theme dark ;;
    "Light Mode"*) shree-theme light ;;
    "Automatic"*)  shree-theme auto ;;
    "Toggle"*)     shree-theme toggle ;;
    "Change Wallpaper"*)
      local wp_list
      wp_list=$(find /usr/share/wallpapers "${HOME}/Pictures" "${HOME}/Desktop" -type f \( -name "*.png" -o -name "*.jpg" -o -name "*.svg" \) 2>/dev/null || true)
      local wp_choice
      wp_choice=$(echo -e "$wp_list" | dmenu -p "Select Wallpaper" -l 6 -c)
      [ -n "$wp_choice" ] && apply_wallpaper "$wp_choice"
      ;;
    "Adjust Transparency"*)
      shree-notify "Compositor" "Window transparency & blur are configured in /etc/X11/picom.conf" --app="Settings"
      ;;
  esac
}

handle_dock() {
  local choice
  choice=$(printf "Auto-Hide: Disabled\nAuto-Hide: Enabled\nRestart Dock Service" | dmenu -p "Dock Settings" -l 3 -c)
  [ -z "$choice" ] && return
  case "$choice" in
    "Auto-Hide: Enabled"*)
      mkdir -p "${HOME}/.config/shreeos"
      echo "AUTOHIDE=true" > "${HOME}/.config/shreeos/dock.conf"
      shree-notify "Dock" "Auto-hide enabled" --app="Settings"
      ;;
    "Auto-Hide: Disabled"*)
      mkdir -p "${HOME}/.config/shreeos"
      echo "AUTOHIDE=false" > "${HOME}/.config/shreeos/dock.conf"
      shree-notify "Dock" "Auto-hide disabled" --app="Settings"
      ;;
    "Restart Dock"*)
      pkill -f "shree-dock" 2>/dev/null || true
      shree-dock --daemon &
      shree-notify "Dock" "Dock restarted" --app="Settings"
      ;;
  esac
}

handle_bluetooth() {
  st -g 88x28 -t "Bluetooth Settings" -e shree-hardware-ui bluetooth &
}

handle_displays() {
  if command -v xrandr >/dev/null 2>&1; then
    st -g 75x20 -t "Display Settings" -e /bin/bash -c "
      echo '=== Connected Displays & Available Resolutions ==='
      echo ''
      xrandr --query
      echo ''
      echo 'Press Enter to close.'
      read -r
    " &
  fi
}

handle_network() {
  local choice
  choice=$(printf "Wi-Fi status and scan\nConnect Wi-Fi network\nEthernet status" | dmenu -p "Network Settings" -l 3 -c || true)
  case "$choice" in
    "Wi-Fi status"*) st -g 88x28 -t "Wi-Fi Settings" -e shree-hardware-ui wifi & ;;
    Connect*) st -g 70x12 -t "Connect Wi-Fi" -e shree-hardware-ui wifi-connect & ;;
    Ethernet*) st -g 88x22 -t "Ethernet Settings" -e shree-hardware-ui ethernet & ;;
  esac
}

handle_sound() {
  local choice
  choice=$(printf "Audio status and devices\nSet volume\nMute\nUnmute" | dmenu -p "Sound Settings" -l 4 -c || true)
  case "$choice" in
    "Audio status"*) st -g 88x24 -t "Audio Settings" -e shree-hardware-ui audio & ;;
    "Set volume"*) st -g 60x10 -t "Volume" -e shree-hardware-ui volume & ;;
    Mute*) shreectl audio mute ;;
    Unmute*) shreectl audio unmute ;;
  esac
}

handle_power() {
  local choice
  choice=$(printf "Battery and power status\nBrightness status\nSet brightness" | dmenu -p "Power Settings" -l 3 -c || true)
  case "$choice" in
    Battery*) st -g 72x20 -t "Power" -e shree-hardware-ui battery & ;;
    "Brightness status"*) st -g 60x12 -t "Brightness" -e shree-hardware-ui brightness & ;;
    Set*) st -g 60x10 -t "Set Brightness" -e shree-hardware-ui brightness-set & ;;
  esac
}

handle_hardware() {
  st -g 100x32 -t "Hardware" -e shree-hardware-ui hardware &
}
handle_drivers() {
  st -g 100x32 -t "Drivers" -e shree-hardware-ui drivers &
}

handle_storage() {
  shree-storage show
}

handle_updates() {
  st -g 80x22 -t "Software Updates" -e /bin/bash -c "system-update.sh; echo ''; echo 'Press Enter to close'; read -r" &
}

handle_default_apps() {
  local type_choice
  type_choice=$(printf "Text Files (text/plain)\nImages (image/png)\nArchives (application/zip)\nWeb Browser" | dmenu -p "Default Apps" -l 4 -c)
  [ -z "$type_choice" ] && return
  case "$type_choice" in
    "Text Files"*)
      local app
      app=$(printf "shree-edit.desktop\nnano.desktop\nvim.desktop" | dmenu -p "Select Text Editor" -l 3 -c)
      [ -n "$app" ] && shree-mime set "text/plain" "$app"
      ;;
    "Images"*)
      local app
      app=$(printf "shree-view.desktop\nfeh.desktop\nsxiv.desktop" | dmenu -p "Select Image Viewer" -l 3 -c)
      [ -n "$app" ] && shree-mime set "image/png" "$app"
      ;;
  esac
}

show_main_menu() {
  local categories="\
Appearance        — Theme (Light/Dark/Auto), wallpapers & transparency
Desktop & Dock    — Wallpaper selection, dock autohide & position
Displays          — Resolution, refresh rates & Night Light
Network           — Wi-Fi discovery, Ethernet & DNS configuration
Bluetooth         — Wireless peripherals and adapter state
Sound             — Master output volume & alert settings
Default Apps      — File associations for editor, image viewer & browser
Storage           — Disk usage overview & package cache cleaner
Software Updates  — Check & apply system package upgrades
About ShreeOS     — Hardware specs, kernel release & system identity"

  categories+=$'\nPower             - Battery, AC power and display brightness\nHardware          - CPU, GPU, memory, storage and network adapters\nDrivers           - Loaded drivers, missing drivers and firmware evidence'
  local target="${1:-}"
  if [ -z "$target" ]; then
    target=$(echo -e "$categories" | dmenu -p "ShreeOS Settings" -l 13 -c || true)
  fi

  [ -z "$target" ] && exit 0

  case "$target" in
    Appearance*|appearance)     handle_appearance ;;
    "Desktop & Dock"*|dock)     handle_dock ;;
    Displays*|displays)         handle_displays ;;
    Network*|network)           handle_network ;;
    Bluetooth*|bluetooth)       handle_bluetooth ;;
    Sound*|sound)               handle_sound ;;
    "Default Apps"*|defaults)   handle_default_apps ;;
    Storage*|storage)           handle_storage ;;
    Power*|power)               handle_power ;;
    Hardware*|hardware)         handle_hardware ;;
    Drivers*|drivers)           handle_drivers ;;
    "Software Updates"*|updates)handle_updates ;;
    "About ShreeOS"*|about)     shree-about & ;;
  esac
}

show_main_menu "$@"
