#!/usr/bin/env bash
# scripts/shree-doctor — Comprehensive ShreeOS System Diagnostics
#
# Inspects kernel, rootfs health, package database, service supervisor,
# network interfaces, DNS, bootloader, disk usage, and permission states.

set -euo pipefail

ISSUES=0

check_pass() {
  printf "  \033[1;32m[✓]\033[0m %s\n" "$1"
}

check_warn() {
  printf "  \033[1;33m[!]\033[0m %s\n" "$1"
  ISSUES=$((ISSUES + 1))
}

check_fail() {
  printf "  \033[1;31m[✗]\033[0m %s\n" "$1"
  ISSUES=$((ISSUES + 1))
}

echo ""
echo "========================================================"
echo "          ShreeOS System Health Diagnostics             "
echo "========================================================"
echo ""

# 1. Kernel & PID 1
if [ "$(uname -s)" = "Linux" ]; then
  check_pass "Linux Kernel $(uname -r) ($(uname -m)) active"
else
  check_fail "Non-Linux operating system kernel detected"
fi

if kill -0 1 2>/dev/null; then
  check_pass "PID 1 (ShreeOS init supervisor) responsive"
else
  check_fail "PID 1 init supervisor unreachable"
fi

# 2. Filesystem & Storage
if [ -d "/proc" ] && [ -d "/sys" ] && [ -d "/dev" ]; then
  check_pass "Virtual filesystems (/proc, /sys, /dev) mounted"
else
  check_fail "Essential virtual filesystems missing or unmounted"
fi

ROOT_FREE=$(df -h / 2>/dev/null | awk 'NR==2 {print $4}' || echo "N/A")
check_pass "Root filesystem healthy (${ROOT_FREE} available)"

# 3. Package Management (LPM)
if [ -d "/var/lib/lpm/installed" ]; then
  PKG_COUNT=$(ls -1 /var/lib/lpm/installed 2>/dev/null | wc -l)
  check_pass "Package database intact (${PKG_COUNT} installed packages)"
else
  check_warn "Package database directory /var/lib/lpm/installed not found"
fi

# 4. Networking & DNS
if ip route get 1.1.1.1 >/dev/null 2>&1; then
  check_pass "Network routing and internet connectivity active"
else
  check_warn "No active default network gateway (Offline / Local only)"
fi

if [ -f "/etc/resolv.conf" ] && [ -s "/etc/resolv.conf" ]; then
  check_pass "DNS resolver configuration present (/etc/resolv.conf)"
else
  check_warn "DNS resolver configuration missing or empty"
fi

# 5. Bootloader & ESP
if [ -d "/boot/grub" ] || [ -f "/boot/grub/grub.cfg" ]; then
  check_pass "GRUB bootloader configuration verified"
else
  check_warn "GRUB bootloader directory /boot/grub not located"
fi

# 6. Service Units
if [ -d "/etc/services.d" ]; then
  SVC_COUNT=$(ls -1 /etc/services.d/*.conf 2>/dev/null | wc -l || echo 0)
  check_pass "Service definitions loaded (${SVC_COUNT} services configured)"
else
  check_pass "Using built-in default service definitions"
fi

echo ""
echo "========================================================"
if [ "$ISSUES" -eq 0 ]; then
  printf "  \033[1;32mSystem is healthy and fully operational (0 issues).\033[0m\n"
else
  printf "  \033[1;33mDiagnostics completed: %d issue(s) detected.\033[0m\n" "$ISSUES"
fi
echo "========================================================"
echo ""
