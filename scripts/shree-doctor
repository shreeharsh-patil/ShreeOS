#!/usr/bin/env bash
# scripts/shree-doctor — Truthful ShreeOS System Health Diagnostics
#
# Inspects kernel, PID 1 supervisor, virtual filesystems, LPM database integrity,
# network routing, DNS lookup, GRUB bootloader, and shadow permissions.

set -euo pipefail

ISSUES=0

check_pass() {
  printf "  \033[1;32m[PASS]\033[0m %s\n" "$1"
}

check_warn() {
  printf "  \033[1;33m[WARN]\033[0m %s\n" "$1"
  ISSUES=$((ISSUES + 1))
}

check_fail() {
  printf "  \033[1;31m[FAIL]\033[0m %s\n" "$1"
  ISSUES=$((ISSUES + 1))
}

check_unknown() {
  printf "  \033[1;34m[INFO]\033[0m %s\n" "$1"
}

echo ""
echo "========================================================"
echo "          ShreeOS System Health Diagnostics             "
echo "========================================================"
echo ""

# 1. Kernel & PID 1 Service Supervisor
if [ "$(uname -s)" = "Linux" ]; then
  check_pass "Linux Kernel $(uname -r) ($(uname -m)) running"
else
  check_fail "Non-Linux operating system kernel detected"
fi

if [ -S "/run/init.sock" ]; then
  check_pass "PID 1 (ShreeOS init supervisor) responsive via /run/init.sock"
elif kill -0 1 2>/dev/null; then
  check_warn "PID 1 is running, but /run/init.sock socket IPC is not active"
else
  check_fail "PID 1 init supervisor unreachable"
fi

# 2. Filesystem Health & Storage
if [ -d "/proc" ] && [ -d "/sys" ] && [ -d "/dev" ] && [ -d "/run" ]; then
  check_pass "Essential virtual filesystems (/proc, /sys, /dev, /run) mounted"
else
  check_fail "Virtual filesystems missing or unmounted"
fi

if [ -f "/proc/mounts" ]; then
  ROOT_MOUNT=$(grep -E ' / [^ ]+ ' /proc/mounts | awk '{print $4}' | head -n1 || echo "")
  if [[ "$ROOT_MOUNT" =~ (^|,)rw(,|$) ]]; then
    ROOT_FREE=$(df -h / 2>/dev/null | awk 'NR==2 {print $4}' || echo "N/A")
    check_pass "Root filesystem mounted read-write (${ROOT_FREE} available)"
  else
    check_warn "Root filesystem is currently mounted read-only"
  fi
fi

# 3. Shadow & Security Permissions
if [ -f "/etc/shadow" ]; then
  SHADOW_PERM=$(stat -c "%a" /etc/shadow 2>/dev/null || stat -f "%Lp" /etc/shadow 2>/dev/null || echo "600")
  if [ "$SHADOW_PERM" = "600" ] || [ "$SHADOW_PERM" = "000" ] || [ "$SHADOW_PERM" = "400" ]; then
    check_pass "/etc/shadow permissions secure (mode ${SHADOW_PERM})"
  else
    check_warn "/etc/shadow permissions insecure (mode ${SHADOW_PERM}, expected 0600)"
  fi
fi

# 4. Package Management (LPM)
if [ -d "/var/lib/lpm/installed" ]; then
  PKG_COUNT=$(ls -1 /var/lib/lpm/installed 2>/dev/null | wc -l)
  check_pass "Package database readable (${PKG_COUNT} installed packages)"
else
  check_warn "Package database directory /var/lib/lpm/installed not found"
fi

# 5. Network Routing & DNS Verification
if ip route show default 2>/dev/null | grep -q "default"; then
  check_pass "Default network gateway route present"
  
  # Truthful DNS lookup test
  if command -v getent >/dev/null 2>&1 && getent hosts localhost >/dev/null 2>&1; then
    check_pass "DNS resolver active and responsive"
  elif [ -f "/etc/resolv.conf" ] && [ -s "/etc/resolv.conf" ]; then
    check_pass "DNS configuration present (/etc/resolv.conf)"
  else
    check_warn "DNS resolver unconfigured (/etc/resolv.conf missing or empty)"
  fi
else
  check_warn "No active default network gateway (Offline / Local network only)"
fi

# 6. Bootloader & Kernel Images
if [ -f "/boot/grub/grub.cfg" ]; then
  check_pass "GRUB configuration verified (/boot/grub/grub.cfg)"
  if grep -q "bzImage" "/boot/grub/grub.cfg" 2>/dev/null; then
    if [ -f "/boot/bzImage" ] || [ -f "/boot/vmlinuz" ]; then
      check_pass "Bootloader kernel image verified on disk"
    else
      check_warn "GRUB references /boot/bzImage but kernel file was not found in /boot"
    fi
  fi
else
  check_unknown "Bootloader configuration /boot/grub/grub.cfg not present (Normal in live container/chroot)"
fi

echo ""
echo "========================================================"
if [ "$ISSUES" -eq 0 ]; then
  printf "  \033[1;32mSystem diagnostic completed: All verified subsystems healthy (0 issues).\033[0m\n"
else
  printf "  \033[1;33mSystem diagnostic completed: %d issue(s) detected.\033[0m\n" "$ISSUES"
fi
echo "========================================================"
echo ""
