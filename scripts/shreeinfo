#!/usr/bin/env bash
# scripts/shreeinfo — Minimal, fast native system information utility for ShreeOS

set -euo pipefail

DISTRO_NAME="ShreeOS"
# Report the version the running system was built as. /etc/os-release is
# generated from the version source of truth during the rootfs stage; when run
# from a checkout (no ShreeOS os-release present) fall back to this tree's
# VERSION file, and only then to the compiled-in default, so the reported
# version cannot go stale.
resolve_version() {
  local version=""
  if [ -r /etc/os-release ] && grep -Eq '^ID=shreeos$' /etc/os-release; then
    version="$(sed -n 's/^VERSION="\(.*\)"$/\1/p' /etc/os-release | head -n 1)"
  fi
  if [ -z "$version" ]; then
    # build.conf derives the version from the repository VERSION file; read
    # that source of truth directly instead of re-parsing the assignment.
    local version_file="${BASH_SOURCE[0]%/*}/../VERSION"
    if [ -r "$version_file" ]; then
      version="$(tr -d '[:space:]' < "$version_file")"
    fi
  fi
  printf '%s' "${version:-unknown}"
}
DISTRO_VERSION="$(resolve_version)"
KERNEL=$(uname -r 2>/dev/null || echo "6.18")
ARCH=$(uname -m 2>/dev/null || echo "x86_64")
HOSTNAME=$(hostname 2>/dev/null || cat /etc/hostname 2>/dev/null || echo "shreeos")
UPTIME=$(uptime -p 2>/dev/null | sed 's/^up //' || echo "just booted")
if command -v dpkg-query >/dev/null 2>&1 && [ -r /var/lib/dpkg/status ]; then
  PACKAGES="$(dpkg-query -W -f='${binary:Package}\n' 2>/dev/null | wc -l)"
  PKG_MANAGER="dpkg/APT"
else
  PACKAGES="$(find /var/lib/lpm/installed -mindepth 1 -maxdepth 1 -type f 2>/dev/null | wc -l || true)"
  PKG_MANAGER="lpm"
fi
SHELL_NAME=$(basename "${SHELL:-/bin/bash}")
WM="${XDG_CURRENT_DESKTOP:-}"
if [ -z "$WM" ]; then
  if [ -n "${KDE_FULL_SESSION:-}" ]; then WM="KDE Plasma"; else WM="dwm / console"; fi
fi

MEM_TOTAL=$(awk '/MemTotal:/ {printf "%.0fM", $2/1024}' /proc/meminfo 2>/dev/null || echo "4096M")
MEM_AVAIL=$(awk '/MemAvailable:/ {printf "%.0fM", $2/1024}' /proc/meminfo 2>/dev/null || echo "2048M")
CPU_MODEL=$(awk -F': ' '/model name/ {print $2; exit}' /proc/cpuinfo 2>/dev/null || echo "x86_64 Processor")

echo ""
echo "      .-----.          ${DISTRO_NAME} ${DISTRO_VERSION}"
echo "     /       \\         ─────────────────────────────────────────"
echo "    |  .---.  |        OS:           ${DISTRO_NAME} (${ARCH})"
echo "    |  |   |  |        Host:         ${HOSTNAME}"
echo "     \\  .-.  /         Kernel:       Linux ${KERNEL}"
echo "      \`-----'          Uptime:       ${UPTIME}"
echo "     /       \\         Packages:     ${PACKAGES} (${PKG_MANAGER})"
echo "    |  .---.  |        Shell:        ${SHELL_NAME}"
echo "    |  |   |  |        Desktop:      ${WM}"
echo "     \\  .-.  /         Processor:    ${CPU_MODEL}"
echo "      \`-----'          Memory:       ${MEM_AVAIL} avail / ${MEM_TOTAL}"
echo ""
