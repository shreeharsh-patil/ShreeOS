#!/usr/bin/env bash
# scripts/shreectl — ShreeOS Central Administration & Control Interface
#
# Unified CLI for system metrics, service control, network management,
# software updates, package DB backups, diagnostics, logs, and power state.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SHREEOS_ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

source "$SHREEOS_ROOT_DIR/build.conf" 2>/dev/null || true
source "$SHREEOS_ROOT_DIR/scripts/common.sh" 2>/dev/null || {
  shreeos_step() { echo "==> $1"; }
  shreeos_ok() { echo "  [OK] $1"; }
  shreeos_warn() { echo "  [WARN] $1"; }
  shreeos_die() { echo "  [ERROR] $1" >&2; exit 1; }
}

usage() {
  cat <<'EOF'
shreectl — ShreeOS Central System Administration Interface

Usage:
  shreectl info                        Display system summary and hardware specs
  shreectl services [list|start|stop|restart|status] Check and control supervised services
  shreectl daemon <status|ping> [--json]  Query the ShreeOS hardware daemon
  shreectl hardware [--json]              Show detected hardware summary
  shreectl cpu|gpu|memory|disks|pci|usb [--json]  Query detected hardware
  shreectl network [interfaces] [--json]     Show network state
  shreectl ethernet [status] [--json]        Show wired Ethernet state
  shreectl wifi <status|list|connect|disconnect|known|forget> [--json]
  shreectl bluetooth <status|enable|disable|scan|devices> [--json]
  shreectl audio <devices|status|volume|mute|unmute> [--json]
  shreectl battery|power [--json]
  shreectl brightness [0-100] [--json]
  shreectl update [check|apply]        Check and apply package updates
  shreectl doctor                      Run comprehensive system health diagnostics
  shreectl logs [service-name|kernel|system] View service and system supervisor logs
  shreectl users [list]                Manage user accounts and permissions
  shreectl backup-db [list|create|restore] Manage LPM package database restore points
  shreectl poweroff                    Power off computer cleanly
  shreectl reboot                      Reboot system cleanly
EOF
}

cmd_info() {
  shreeinfo
}

cmd_services() {
  local sub="${1:-list}"
  shift 2>/dev/null || true
  case "$sub" in
    list)
      initctl list 2>/dev/null || initctl status
      ;;
    status)
      local svc="${1:-}"
      if [ -n "$svc" ]; then
        initctl status "$svc"
      else
        initctl status
      fi
      ;;
    start)
      local svc="${1:-}"
      [ -z "$svc" ] && { echo "Usage: shreectl services start <service>"; exit 1; }
      initctl start "$svc"
      ;;
    stop)
      local svc="${1:-}"
      [ -z "$svc" ] && { echo "Usage: shreectl services stop <service>"; exit 1; }
      initctl stop "$svc"
      ;;
    restart)
      local svc="${1:-}"
      [ -z "$svc" ] && { echo "Usage: shreectl services restart <service>"; exit 1; }
      initctl restart "$svc"
      ;;
    reload)
      initctl reload
      ;;
    *)
      initctl "$sub" "$@"
      ;;
  esac
}

cmd_daemon() {
  local sub="${1:-status}"
  shift 2>/dev/null || true

  case "$sub" in
    status|ping)
      if [ "$#" -gt 1 ] || { [ "$#" -eq 1 ] && [ "$1" != "--json" ]; }; then
        echo "Usage: shreectl daemon <status|ping> [--json]" >&2
        return 1
      fi
      shreedctl "$sub" "$@"
      ;;
    *)
      echo "Usage: shreectl daemon <status|ping> [--json]" >&2
      return 1
      ;;
  esac
}

cmd_hardware() {
  local action="$1"
  shift
  if [ "$#" -gt 1 ] || { [ "$#" -eq 1 ] && [ "$1" != "--json" ]; }; then
    echo "Usage: shreectl ${action} [--json]" >&2
    return 1
  fi
  shreedctl "$action" "$@"
}

cmd_network() {
  local sub="network"
  if [ "${1:-}" = "interfaces" ] || [ "${1:-}" = "status" ]; then
    sub="$1"
    shift
  fi
  case "$sub" in
    network|status) shreedctl network "$@" ;;
    interfaces) shreedctl interfaces "$@" ;;
    *) echo "Usage: shreectl network [interfaces] [--json]" >&2; return 1 ;;
  esac
}

cmd_ethernet() {
  local sub="ethernet"
  if [ "${1:-}" = "status" ]; then
    sub="$1"
    shift
  fi
  case "$sub" in
    ethernet|status) shreedctl ethernet "$@" ;;
    *) echo "Usage: shreectl ethernet [status] [--json]" >&2; return 1 ;;
  esac
}

cmd_wifi() { /usr/sbin/shree-wifi "$@"; }
cmd_bluetooth() { /usr/sbin/shree-bluetooth "$@"; }
cmd_audio() { /usr/sbin/shree-audio "$@"; }
cmd_powerctl() { /usr/sbin/shree-powerctl "$@"; }

cmd_update() {
  local sub="${1:-apply}"
  case "$sub" in
    check) system-update.sh --check-only ;;
    apply) system-update.sh ;;
    *)     echo "Usage: shreectl update [check|apply]"; exit 1 ;;
  esac
}

cmd_doctor() {
  shree-doctor
}

cmd_logs() {
  local target="${1:-system}"
  if [ -f "/var/log/shreeos/services/${target}.log" ]; then
    tail -n 50 "/var/log/shreeos/services/${target}.log"
  elif [ "$target" = "kernel" ]; then
    dmesg 2>/dev/null | tail -n 50 || echo "Kernel logs unavailable"
  else
    if [ -d "/var/log/shreeos/services" ]; then
      echo "Available service logs:"
      ls -1 /var/log/shreeos/services/ 2>/dev/null || true
    fi
    dmesg 2>/dev/null | tail -n 30 || echo "Logs unavailable"
  fi
}

cmd_users() {
  local sub="${1:-list}"
  case "$sub" in
    list)
      echo "Configured User Accounts:"
      awk -F':' '$3 >= 1000 && $3 < 65000 {printf "  - %s (UID: %d, Home: %s)\n", $1, $3, $6}' /etc/passwd 2>/dev/null || echo "No users found"
      ;;
    *)
      echo "Usage: shreectl users list"
      ;;
  esac
}

cmd_backup_db() {
  local sub="${1:-list}"
  local snap_dir="/var/lib/lpm/snapshots"
  mkdir -p "$snap_dir"
  case "$sub" in
    list)
      echo "LPM Package Database Backups:"
      ls -lh "$snap_dir" 2>/dev/null || echo "No backups recorded"
      ;;
    create)
      local id
      id="db_$(date +%Y%m%d_%H%M%S)"
      cp -r /var/lib/lpm/installed "${snap_dir}/${id}" 2>/dev/null || true
      shreeos_ok "Created package DB backup: ${id}"
      ;;
    restore)
      local id="${2:-}"
      if [ -z "$id" ] || [ ! -d "${snap_dir}/${id}" ]; then
        shreeos_die "Usage: shreectl backup-db restore <backup_id>"
      fi
      cp -r "${snap_dir}/${id}/"* /var/lib/lpm/installed/
      shreeos_ok "Restored package DB from: ${id}"
      ;;
  esac
}

[ $# -lt 1 ] && { usage; exit 0; }

COMMAND="$1"
shift

case "$COMMAND" in
  info)        cmd_info "$@" ;;
  services)    cmd_services "$@" ;;
  daemon)      cmd_daemon "$@" ;;
  hardware|cpu|gpu|memory|disks|pci|usb) cmd_hardware "$COMMAND" "$@" ;;
  network)     cmd_network "$@" ;;
  ethernet)    cmd_ethernet "$@" ;;
  wifi)        cmd_wifi "$@" ;;
  bluetooth)   cmd_bluetooth "$@" ;;
  audio)       cmd_audio "$@" ;;
  battery|power) cmd_powerctl "$COMMAND" "$@" ;;
  brightness)  cmd_powerctl brightness "$@" ;;
  update)      cmd_update "$@" ;;
  doctor)      cmd_doctor "$@" ;;
  logs)        cmd_logs "$@" ;;
  users)       cmd_users "$@" ;;
  backup-db|snapshots) cmd_backup_db "$@" ;;
  reboot)      initctl reboot ;;
  poweroff)    initctl poweroff ;;
  --help|-h)   usage ;;
  *)           echo "shreectl: unknown command '$COMMAND'"; usage; exit 1 ;;
esac
