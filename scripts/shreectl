#!/usr/bin/env bash
# scripts/shreectl — ShreeOS Central Administration & Control Interface
#
# Unified CLI for system metrics, service control, network management,
# software updates, snapshots, diagnostics, logs, and power state.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SHREEOS_ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

source "$SHREEOS_ROOT_DIR/build.conf" 2>/dev/null || true
source "$SHREEOS_ROOT_DIR/scripts/common.sh" 2>/dev/null || {
  shreeos_step() { echo "==> $1"; }
  shreeos_ok() { echo "  [OK] $1"; }
  shreeos_warn() { echo "  [WARN] $1"; }
  shreeos_die() { echo "  [ERROR] $1" >&2; exit 1; }
}

usage() {
  cat <<'EOF'
shreectl — ShreeOS Central System Administration Interface

Usage:
  shreectl info                        Display system summary and hardware specs
  shreectl services [list|restart <s]| Check and control supervised system services
  shreectl network [status|ip|restart] Manage network interfaces and connectivity
  shreectl update [check|apply]        Check and apply atomic package updates
  shreectl doctor                      Run comprehensive system health diagnostics
  shreectl logs [init|kernel|system]   View system and service supervisor logs
  shreectl users [list|add|remove]     Manage user accounts and permissions
  shreectl snapshots [list|create|rollback] Manage package transaction restore points
  shreectl poweroff                    Power off computer cleanly
  shreectl reboot                      Reboot system cleanly
EOF
}

cmd_info() {
  shreeinfo
}

cmd_services() {
  local sub="${1:-list}"
  shift || true
  case "$sub" in
    list|status)
      initctl status
      ;;
    restart)
      local svc="${1:-}"
      if [ -z "$svc" ]; then echo "Usage: shreectl services restart <service>"; exit 1; fi
      initctl reload
      shreeos_ok "Requested reload for service: ${svc}"
      ;;
    *)
      initctl "$sub" "$@"
      ;;
  esac
}

cmd_network() {
  local sub="${1:-status}"
  shift || true
  case "$sub" in
    status) shree-net status ;;
    ip)     shree-net ip ;;
    scan)   shree-net scan ;;
    restart) shree-net restart ;;
    *)      echo "Usage: shreectl network [status|ip|scan|restart]"; exit 1 ;;
  esac
}

cmd_update() {
  local sub="${1:-apply}"
  case "$sub" in
    check) system-update.sh --check-only ;;
    apply) system-update.sh ;;
    *)     echo "Usage: shreectl update [check|apply]"; exit 1 ;;
  esac
}

cmd_doctor() {
  shree-doctor
}

cmd_logs() {
  local target="${1:-init}"
  case "$target" in
    kernel) dmesg 2>/dev/null | tail -n 50 || echo "Kernel logs unavailable" ;;
    init|system|*) cat /var/log/messages 2>/dev/null | tail -n 50 || dmesg 2>/dev/null | tail -n 30 || echo "Logs unavailable" ;;
  esac
}

cmd_users() {
  local sub="${1:-list}"
  case "$sub" in
    list)
      echo "Configured User Accounts:"
      awk -F':' '$3 >= 1000 && $3 < 65000 {printf "  - %s (UID: %d, Home: %s)\n", $1, $3, $6}' /etc/passwd 2>/dev/null || echo "No users found"
      ;;
    *)
      echo "Usage: shreectl users list"
      ;;
  esac
}

cmd_snapshots() {
  local sub="${1:-list}"
  local snap_dir="/var/lib/lpm/snapshots"
  mkdir -p "$snap_dir"
  case "$sub" in
    list)
      echo "ShreeOS Package Transaction Snapshots:"
      ls -lh "$snap_dir" 2>/dev/null || echo "No snapshots recorded"
      ;;
    create)
      local id
      id="snap_$(date +%Y%m%d_%H%M%S)"
      cp -r /var/lib/lpm/installed "${snap_dir}/${id}" 2>/dev/null || true
      shreeos_ok "Created transaction snapshot: ${id}"
      ;;
    rollback)
      local id="${2:-}"
      if [ -z "$id" ] || [ ! -d "${snap_dir}/${id}" ]; then
        shreeos_die "Usage: shreectl snapshots rollback <snapshot_id>"
      fi
      cp -r "${snap_dir}/${id}/"* /var/lib/lpm/installed/
      shreeos_ok "Rolled back package database to snapshot: ${id}"
      ;;
  esac
}

[ $# -lt 1 ] && { usage; exit 0; }

COMMAND="$1"
shift

case "$COMMAND" in
  info)       cmd_info "$@" ;;
  services)   cmd_services "$@" ;;
  network)    cmd_network "$@" ;;
  update)     cmd_update "$@" ;;
  doctor)     cmd_doctor "$@" ;;
  logs)       cmd_logs "$@" ;;
  users)      cmd_users "$@" ;;
  snapshots)  cmd_snapshots "$@" ;;
  reboot)     initctl reboot ;;
  poweroff)   initctl poweroff ;;
  --help|-h)  usage ;;
  *)          echo "shreectl: unknown command '$COMMAND'"; usage; exit 1 ;;
esac
