#!/usr/bin/python3
"""ShreeOS quick controls for the XFCE desktop."""

import subprocess
import sys
from pathlib import Path
sys.path.insert(0, "/usr/local/lib/shreeos")

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gdk, GLib, Gtk
from ui_theme import current_dark, themed_css, tokens


CSS = """
window.shreeos-control-center {
  background-color: @bg@;
  color: @text@;
  font-family: '@font_ui@';
}
headerbar.shreeos-header {
  background: @bg@;
  border: 0;
  box-shadow: none;
  min-height: 46px;
}
.cc-title { font-size: @font_size_title@; font-weight: 600; color: @text@; }
.cc-caption { color: @text_secondary@; font-size: @font_size_sm@; }
.cc-section { color: @text_muted@; font-size: @font_size_sm@; font-weight: 600; }
button.cc-tile {
  background: @surface_alt@;
  color: @text@;
  border: 1px solid @border_hex@;
  border-radius: @radius_window@;
  padding: 10px 12px;
  min-height: 68px;
}
button.cc-tile:hover { background: @surface@; border-color: @accent_light@; }
button.cc-tile:focus { border-color: @accent@; }
.cc-tile { background: @surface_alt@; border: 1px solid @border_hex@; border-radius: @radius_window@; padding: 10px 12px; }
.cc-tile-title { font-weight: 600; }
button.cc-link {
  background: @surface_alt@;
  color: @text@;
  border: 1px solid @border_hex@;
  border-radius: @radius_control@;
  padding: 8px 12px;
}
button.cc-link:hover { background: @surface@; }
label.cc-status { color: @text_secondary@; font-size: @font_size_sm@; }
box.settings-sidebar { background: @surface_alt@; }
list.settings-navigation { background: transparent; }
list.settings-navigation row { color: @text@; border-radius: @radius_control@; padding: 7px 9px; }
list.settings-navigation row:selected { background: @accent_muted@; color: @accent@; }
label.settings-navigation-title { color: @text@; font-weight: 600; }
label.settings-page-caption { color: @text_secondary@; font-size: @font_size_ui@; }
entry.settings-search { background: @surface@; color: @text@; border: 1px solid @border_hex@;
  border-radius: @radius_control@; padding: 7px 9px; }
entry.settings-search:focus { border-color: @accent@; }
separator.settings-separator { background: @border_hex@; }
"""


def run_command(argv: list[str]) -> str:
    result = subprocess.run(argv, capture_output=True, text=True, timeout=4, check=False)
    if result.returncode:
        detail = result.stderr.strip() or result.stdout.strip() or "The control is unavailable."
        raise RuntimeError(detail)
    return result.stdout.strip()


def wifi_enabled() -> bool:
    return run_command(["nmcli", "-t", "-f", "WIFI", "general"]).lower() == "enabled"


def bluetooth_enabled() -> bool:
    return "powered: yes" in run_command(["bluetoothctl", "show"]).lower()


def set_bluetooth_power(enabled: bool) -> None:
    try:
        run_command(["bluetoothctl", "power", "on" if enabled else "off"])
    except RuntimeError as error:
        if "no default controller" not in str(error).lower():
            raise


def airplane_mode_enabled() -> bool:
    return not wifi_enabled() and not bluetooth_enabled()


def audio_muted() -> bool:
    output = run_command(["pactl", "get-sink-mute", "@DEFAULT_SINK@"])
    return output.strip().lower().endswith("yes")


def dark_theme_enabled() -> bool:
    return current_dark()


def appearance_css(dark: bool) -> str:
    return themed_css(CSS, dark)


def apply_appearance(dark: bool) -> None:
    theme = "Arc-Dark" if dark else "Arc"
    icons = "Papirus-Dark" if dark else "Papirus"
    wallpaper = "shreeos-calm-dark.png" if dark else "shreeos-calm-light.png"
    dock = "ShreeOS" if dark else "ShreeOS-Light"
    token_values = tokens()
    surface_key = "SHREE_DARK_DESKTOP_BG" if dark else "SHREE_LIGHT_DESKTOP_BG"
    surface = token_values.get(surface_key, "#19191B" if dark else "#F4EFE9").lstrip("#")
    try:
        channels = [int(surface[index:index + 2], 16) / 255 for index in (0, 2, 4)]
        opacity = max(0.45, min(0.96, float(token_values.get("SHREE_GLASS_OPACITY", "0.88"))))
    except (ValueError, IndexError):
        channels = [0.10, 0.10, 0.11] if dark else [0.96, 0.94, 0.91]
        opacity = 0.88
    run_command(["xfconf-query", "-c", "xsettings", "-p", "/Net/ThemeName", "-s", theme])
    run_command(["xfconf-query", "-c", "xsettings", "-p", "/Net/IconThemeName", "-s", icons])
    run_command(["xfconf-query", "-c", "xsettings", "-p", "/Gtk/PreferDarkTheme", "-s", str(dark).lower()])
    run_command(["xfconf-query", "-c", "xfwm4", "-p", "/general/theme", "-s", theme])
    run_command([
        "xfconf-query", "-c", "xfce4-panel", "-p", "/panels/panel-1/background-rgba",
        "--create", "-t", "double", "-t", "double", "-t", "double", "-t", "double",
        "-s", str(channels[0]), "-s", str(channels[1]), "-s", str(channels[2]), "-s", str(opacity),
    ])
    backdrops = run_command(["xfconf-query", "-c", "xfce4-desktop", "-l"]).splitlines()
    for path in (item for item in backdrops
                 if item.startswith("/backdrop/") and item.endswith("/last-image")):
        run_command([
            "xfconf-query", "-c", "xfce4-desktop", "-p", path, "-s",
            f"/usr/share/backgrounds/shreeos/{wallpaper}",
        ])
    run_command([
        "dconf", "write", "/net/launchpad/plank/docks/dock1/theme", f"'{dock}'",
    ])


def focus_enabled() -> bool:
    result = run_command(["xfconf-query", "-c", "xfce4-notifyd", "-p", "/do-not-disturb"])
    return result.strip().lower() == "true"


def brightness_percentage() -> int:
    current = int(run_command(["brightnessctl", "get"]))
    maximum = int(run_command(["brightnessctl", "max"]))
    if maximum <= 0:
        raise RuntimeError("No adjustable display backlight was found.")
    return max(0, min(100, round(current * 100 / maximum)))


def battery_status() -> tuple[int, str] | None:
    for supply in Path("/sys/class/power_supply").glob("*"):
        try:
            if (supply / "type").read_text(encoding="ascii").strip() != "Battery":
                continue
            capacity = int((supply / "capacity").read_text(encoding="ascii").strip())
            status = (supply / "status").read_text(encoding="ascii").strip()
        except (OSError, ValueError):
            continue
        return max(0, min(100, capacity)), status
    return None


def state_or_default(probe, default: bool = False) -> bool:
    try:
        return probe()
    except (OSError, RuntimeError, subprocess.TimeoutExpired):
        return default


def show_error(parent: Gtk.Window, title: str, error: Exception) -> None:
    dialog = Gtk.MessageDialog(
        transient_for=parent,
        modal=True,
        message_type=Gtk.MessageType.ERROR,
        buttons=Gtk.ButtonsType.CLOSE,
        text=title,
    )
    dialog.format_secondary_text(str(error))
    dialog.run()
    dialog.destroy()


def control_tile(icon_name: str, title: str, subtitle: str,
                 callback) -> Gtk.Button:
    button = Gtk.Button()
    button.set_relief(Gtk.ReliefStyle.NONE)
    button.get_style_context().add_class("cc-tile")
    row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
    image = Gtk.Image.new_from_icon_name(icon_name, Gtk.IconSize.DIALOG)
    image.set_pixel_size(25)
    labels = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
    name = Gtk.Label(label=title, xalign=0)
    name.get_style_context().add_class("cc-tile-title")
    detail = Gtk.Label(label=subtitle, xalign=0)
    detail.get_style_context().add_class("cc-caption")
    labels.pack_start(name, False, False, 0)
    labels.pack_start(detail, False, False, 0)
    row.pack_start(image, False, False, 0)
    row.pack_start(labels, True, True, 0)
    button.add(row)
    button.connect("clicked", callback)
    return button


def main() -> int:
    provider = Gtk.CssProvider()
    provider.load_from_data(appearance_css(state_or_default(dark_theme_enabled, True)).encode("utf-8"))
    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
    )

    window = Gtk.Window(title="System Settings — ShreeOS")
    window.set_default_size(900, 640)
    window.set_resizable(True)
    window.set_position(Gtk.WindowPosition.CENTER)
    window.get_style_context().add_class("shreeos-control-center")

    header = Gtk.HeaderBar()
    header.set_show_close_button(True)
    header.set_title("System Settings")
    header.set_subtitle("ShreeOS")
    header.get_style_context().add_class("shreeos-header")
    logo = Gtk.Image.new_from_file("/usr/share/pixmaps/shreeos-logo.svg")
    logo.set_pixel_size(28)
    header.pack_start(logo)
    window.set_titlebar(header)

    paned = Gtk.Paned(orientation=Gtk.Orientation.HORIZONTAL)
    window.add(paned)
    sidebar = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
    sidebar.set_border_width(14)
    sidebar.set_size_request(205, -1)
    sidebar.get_style_context().add_class("settings-sidebar")
    search = Gtk.SearchEntry()
    search.set_placeholder_text("Search settings")
    search.get_style_context().add_class("settings-search")
    sidebar.pack_start(search, False, False, 0)
    navigation = Gtk.ListBox()
    navigation.set_selection_mode(Gtk.SelectionMode.SINGLE)
    navigation.get_style_context().add_class("settings-navigation")
    sidebar.pack_start(navigation, True, True, 0)
    paned.pack1(sidebar, False, False)

    stack = Gtk.Stack()
    stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
    stack.set_transition_duration(120)
    stack.set_hexpand(True)
    stack.set_vexpand(True)
    paned.pack2(stack, True, False)
    paned.set_position(220)

    network_status = "Wi-Fi is on" if wifi_enabled() else "Wi-Fi is off"
    try:
        bt_status = "Bluetooth is on" if bluetooth_enabled() else "Bluetooth is off"
    except (OSError, RuntimeError, subprocess.TimeoutExpired):
        bt_status = "No adapter available"
    try:
        audio_status = "Audio is muted" if audio_muted() else "Audio is on"
    except (OSError, RuntimeError, subprocess.TimeoutExpired):
        audio_status = "No audio output detected"
    theme_status = "Dark appearance" if dark_theme_enabled() else "Light appearance"

    def change_appearance(enabled: bool) -> None:
        apply_appearance(enabled)
        provider.load_from_data(appearance_css(enabled).encode("utf-8"))

    def toggle_switch(title: str, subtitle: str, icon: str, initial: bool, command) -> Gtk.Box:
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        box.get_style_context().add_class("cc-tile")
        image = Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.DIALOG)
        image.set_pixel_size(22)
        labels = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        name = Gtk.Label(label=title, xalign=0)
        name.get_style_context().add_class("cc-tile-title")
        status = Gtk.Label(label=subtitle, xalign=0)
        status.get_style_context().add_class("cc-status")
        labels.pack_start(name, False, False, 0)
        labels.pack_start(status, False, False, 0)
        switch = Gtk.Switch()
        switch.set_active(initial)
        switch.set_valign(Gtk.Align.CENTER)

        def on_toggle(widget, _param) -> None:
            try:
                command(widget.get_active())
                status.set_text("On" if widget.get_active() else "Off")
            except (OSError, RuntimeError, subprocess.TimeoutExpired) as error:
                widget.handler_block_by_func(on_toggle)
                widget.set_active(not widget.get_active())
                widget.handler_unblock_by_func(on_toggle)
                show_error(window, f"Could not change {title.lower()}", error)

        switch.connect("notify::active", on_toggle)
        box.pack_start(image, False, False, 0)
        box.pack_start(labels, True, True, 0)
        box.pack_end(switch, False, False, 0)
        return box

    wifi = toggle_switch(
        "Wi-Fi", network_status, "network-wireless-symbolic", state_or_default(wifi_enabled),
        lambda enabled: run_command(["nmcli", "radio", "wifi", "on" if enabled else "off"]),
    )
    bluetooth = toggle_switch(
        "Bluetooth", bt_status, "bluetooth-active-symbolic", state_or_default(bluetooth_enabled),
        lambda enabled: run_command(["bluetoothctl", "power", "on" if enabled else "off"]),
    )
    muted = toggle_switch(
        "Sound", audio_status, "audio-volume-high-symbolic", not state_or_default(audio_muted),
        lambda enabled: run_command(["pactl", "set-sink-mute", "@DEFAULT_SINK@", "0" if enabled else "1"]),
    )
    dark = toggle_switch(
        "Dark appearance", theme_status, "preferences-desktop-theme-symbolic", state_or_default(dark_theme_enabled),
        change_appearance,
    )
    focus = toggle_switch(
        "Focus mode", "Do not disturb notifications", "notifications-disabled-symbolic",
        state_or_default(focus_enabled),
        lambda enabled: run_command([
            "xfconf-query", "-c", "xfce4-notifyd", "-p", "/do-not-disturb",
            "--create", "-t", "bool", "-s", "true" if enabled else "false",
        ]),
    )
    radio_restore_state = {"wifi": True, "bluetooth": True}

    def change_airplane_mode(enabled: bool) -> None:
        if enabled:
            radio_restore_state["wifi"] = state_or_default(wifi_enabled)
            radio_restore_state["bluetooth"] = state_or_default(bluetooth_enabled)
            set_bluetooth_power(False)
            run_command(["nmcli", "radio", "wifi", "off"])
        else:
            run_command([
                "nmcli", "radio", "wifi",
                "on" if radio_restore_state["wifi"] else "off",
            ])
            set_bluetooth_power(radio_restore_state["bluetooth"])

    airplane = toggle_switch(
        "Airplane mode", "Turn off wireless radios", "airplane-mode-symbolic",
        state_or_default(airplane_mode_enabled), change_airplane_mode,
    )
    brightness_box = None
    try:
        initial_brightness = brightness_percentage()
    except (OSError, RuntimeError, ValueError, subprocess.TimeoutExpired):
        initial_brightness = None
    if initial_brightness is not None:
        brightness_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        brightness_box.get_style_context().add_class("cc-tile")
        brightness_icon = Gtk.Image.new_from_icon_name("display-brightness-symbolic", Gtk.IconSize.DIALOG)
        brightness_icon.set_pixel_size(22)
        brightness_labels = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        brightness_label = Gtk.Label(label="Brightness", xalign=0)
        brightness_label.get_style_context().add_class("cc-tile-title")
        brightness_value = Gtk.Label(label=f"{initial_brightness}%", xalign=0)
        brightness_value.get_style_context().add_class("cc-status")
        brightness_slider = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        brightness_slider.set_draw_value(False)
        brightness_slider.set_hexpand(True)
        brightness_slider.set_value(initial_brightness)
        brightness_labels.pack_start(brightness_label, False, False, 0)
        brightness_labels.pack_start(brightness_value, False, False, 0)
        pending_brightness = {"source": 0}

        def apply_brightness():
            pending_brightness["source"] = 0
            try:
                percent = int(round(brightness_slider.get_value()))
                run_command(["brightnessctl", "set", f"{percent}%"])
                brightness_value.set_text(f"{percent}%")
            except (OSError, RuntimeError, subprocess.TimeoutExpired) as error:
                show_error(window, "Could not change brightness", error)
            return GLib.SOURCE_REMOVE

        def queue_brightness(_scale):
            if pending_brightness["source"]:
                GLib.source_remove(pending_brightness["source"])
            pending_brightness["source"] = GLib.timeout_add(140, apply_brightness)

        brightness_slider.connect("value-changed", queue_brightness)
        brightness_box.pack_start(brightness_icon, False, False, 0)
        brightness_box.pack_start(brightness_labels, False, False, 0)
        brightness_box.pack_start(brightness_slider, True, True, 0)

    battery = battery_status()
    battery_box = None
    if battery is not None:
        capacity, status = battery
        battery_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        battery_box.get_style_context().add_class("cc-tile")
        battery_icon = Gtk.Image.new_from_icon_name("battery-good-symbolic", Gtk.IconSize.DIALOG)
        battery_icon.set_pixel_size(22)
        battery_label = Gtk.Label(label=f"Battery  ·  {capacity}%  ·  {status}", xalign=0)
        battery_label.get_style_context().add_class("cc-tile-title")
        battery_box.pack_start(battery_icon, False, False, 0)
        battery_box.pack_start(battery_label, True, True, 0)

    def open_settings(_button, command: list[str]) -> None:
        try:
            subprocess.Popen(command, close_fds=True)
        except OSError as error:
            show_error(window, "Settings could not be opened", error)

    def settings_link(label: str, icon: str, command: list[str]) -> Gtk.Button:
        button = Gtk.Button(label=label)
        button.set_image(Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.BUTTON))
        button.set_always_show_image(True)
        button.set_halign(Gtk.Align.FILL)
        button.get_style_context().add_class("cc-link")
        button.connect("clicked", open_settings, command)
        return button

    page_specs = [
        ("network", "Network", "network-wireless-symbolic",
         "Manage Wi-Fi and wireless radios.",
         [wifi, airplane, settings_link("Network Connections…", "network-wired-symbolic", ["nm-connection-editor"])]),
        ("bluetooth", "Bluetooth", "bluetooth-active-symbolic",
         "Connect and manage nearby devices.",
         [bluetooth, settings_link("Bluetooth Devices…", "bluetooth-active-symbolic", ["blueman-manager"])]),
        ("sound", "Sound", "audio-volume-high-symbolic",
         "Control the default audio output.",
         [muted, settings_link("Sound Settings…", "audio-card-symbolic", ["pavucontrol"])]),
        ("appearance", "Appearance", "preferences-desktop-theme-symbolic",
         "Choose a light or dark appearance for your desktop.",
         [dark, settings_link("More Appearance Options…", "preferences-desktop-theme-symbolic", ["xfce4-appearance-settings"])]),
        ("displays", "Displays", "video-display-symbolic",
         "Adjust display brightness and open display configuration.",
         ([brightness_box] if brightness_box else []) +
         [settings_link("Display Settings…", "video-display-symbolic", ["xfce4-display-settings"])]),
        ("focus", "Focus", "notifications-disabled-symbolic",
         "Manage notifications and reduce interruptions.",
         [focus, settings_link("Notification Settings…", "preferences-system-notifications-symbolic", ["xfce4-notifyd-config"])]),
        ("power", "Power", "preferences-system-power-symbolic",
         "Review battery status and power settings.",
         ([battery_box] if battery_box else []) +
         [settings_link("Power Settings…", "preferences-system-power-symbolic", ["xfce4-power-manager-settings"])]),
        ("desktop", "Desktop & Dock", "preferences-desktop-dock-symbolic",
         "Tune the desktop, dock, and workspace behavior.",
         [settings_link("Dock Preferences…", "preferences-desktop-dock-symbolic", ["plank", "--preferences"])]),
        ("accessibility", "Accessibility", "preferences-desktop-accessibility-symbolic",
         "Configure assistive tools and accessibility options.",
         [settings_link("Accessibility Settings…", "preferences-desktop-accessibility-symbolic", ["xfce4-accessibility-settings"])]),
        ("about", "About ShreeOS", "help-about-symbolic",
         "Learn about this ShreeOS desktop and system.",
         [settings_link("About ShreeOS…", "help-about-symbolic", ["/usr/local/bin/shreeos-about"])]),
    ]

    page_by_row = {}
    rows = []
    for key, title, icon, description, widgets in page_specs:
        row = Gtk.ListBoxRow()
        row_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=9)
        image = Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.BUTTON)
        label = Gtk.Label(label=title, xalign=0)
        label.get_style_context().add_class("settings-navigation-title")
        row_box.pack_start(image, False, False, 0)
        row_box.pack_start(label, True, True, 0)
        row.add(row_box)
        navigation.add(row)
        page_by_row[row] = key
        rows.append((row, title))

        page_scroll = Gtk.ScrolledWindow()
        page_scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        page.set_border_width(24)
        heading = Gtk.Label(label=title, xalign=0)
        heading.get_style_context().add_class("cc-title")
        caption = Gtk.Label(label=description, xalign=0)
        caption.set_line_wrap(True)
        caption.get_style_context().add_class("settings-page-caption")
        page.pack_start(heading, False, False, 0)
        page.pack_start(caption, False, False, 0)
        divider = Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL)
        divider.get_style_context().add_class("settings-separator")
        page.pack_start(divider, False, False, 4)
        for widget in widgets:
            page.pack_start(widget, False, False, 0)
        page_scroll.add(page)
        stack.add_named(page_scroll, key)

    def select_category(_list, row) -> None:
        if row is not None:
            stack.set_visible_child_name(page_by_row[row])

    navigation.connect("row-selected", select_category)

    def filter_categories(entry) -> None:
        query = entry.get_text().strip().casefold()
        for row, title in rows:
            row.set_visible(not query or query in title.casefold())
        selected = navigation.get_selected_row()
        if selected is None or not selected.get_visible():
            for row, _title in rows:
                if row.get_visible():
                    navigation.select_row(row)
                    break

    search.connect("search-changed", filter_categories)
    navigation.select_row(next(row for row, title in rows if title == "Appearance"))

    def on_key_press(_window, event):
        if event.keyval == Gdk.KEY_Escape:
            window.destroy()
            return True
        return False

    window.connect("key-press-event", on_key_press)
    window.connect("destroy", lambda *_args: Gtk.main_quit())
    window.show_all()
    Gtk.main()
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, RuntimeError, subprocess.TimeoutExpired) as error:
        print(f"shreeos-control-center: {error}", file=sys.stderr)
        sys.exit(1)
