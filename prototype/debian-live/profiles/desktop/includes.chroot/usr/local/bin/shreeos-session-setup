#!/bin/sh
set -eu

marker="$HOME/.config/shreeos/xfce-session-ready"
[ -e "$marker" ] && exit 0
log_exit_status() {
  setup_status=$?
  logger -t shreeos-session-setup "exited with status ${setup_status}"
}
trap log_exit_status EXIT
logger -t shreeos-session-setup 'Applying ShreeOS XFCE panel and wallpaper defaults'
mkdir -p "$HOME/.cache"
exec >>"$HOME/.cache/shreeos-session-setup.log" 2>&1

logger -t shreeos-session-setup 'Applying panel geometry'
xfconf-query -c xfce4-panel -p /panels/panel-1/length -s 100
xfconf-query -c xfce4-panel -p /panels/panel-1/length-adjust -s false
xfconf-query -c xfce4-panel -p /panels/panel-1/position -s 'p=6;x=0;y=0'
xfconf-query -c xfce4-panel -p /panels/panel-1/position-locked -s true
xfconf-query -c xfce4-panel -p /panels/panel-1/size -s 34

wallpaper=/usr/share/backgrounds/shreeos/shreeos-calm-dark.svg
logger -t shreeos-session-setup 'Applying ShreeOS wallpaper to available workspaces'
for monitor in monitor0 monitor1 monitorVirtual-1; do
  for workspace in workspace0 workspace1 workspace2 workspace3; do
    image_property="/backdrop/screen0/$monitor/$workspace/last-image"
    style_property="/backdrop/screen0/$monitor/$workspace/image-style"
    xfconf-query -c xfce4-desktop -p "$image_property" --create --type string -s "$wallpaper"
    xfconf-query -c xfce4-desktop -p "$style_property" --create --type int -s 5
  done
done
logger -t shreeos-session-setup 'Reloading XFCE desktop to draw the ShreeOS wallpaper'
xfdesktop --reload

# xfce4-panel reads its layout during session startup and listens for xfconf
# changes. Restarting it from this autostart hook races the session manager's
# own panel startup and can leave the desktop without a mapped panel window.
mkdir -p "${marker%/*}"
touch "$marker"
logger -t shreeos-session-setup 'ShreeOS first-login desktop setup completed'
