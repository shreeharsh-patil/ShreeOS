#!/bin/sh
set -eu

config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
marker="$config_home/shreeos/desktop-profile-v1"

if [ ! -e "$marker" ]; then
  mkdir -p "$(dirname "$marker")"
  dconf load /net/launchpad/plank/docks/dock1/ \
    < /usr/share/shreeos/defaults/plank.dconf
  : > "$marker"
fi

exec plank
