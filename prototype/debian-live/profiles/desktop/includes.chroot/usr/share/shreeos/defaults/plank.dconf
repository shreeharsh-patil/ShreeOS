[net/launchpad/plank/docks/dock1]
alignment='center'
auto-pinning=true
current-workspace-only=false
dock-items=['thunar.dockitem', 'firefox-esr.dockitem', 'shreeos-search.dockitem', 'xfce4-terminal.dockitem', 'ristretto.dockitem', 'mousepad.dockitem', 'shreeos-overview.dockitem', 'shreeos-control-center.dockitem', 'xfce4-settings-manager.dockitem', 'downloads.dockitem', 'trash.dockitem']
hide-mode='intelligent'
icon-size=48
items-alignment='center'
lock-items=false
offset=0
position='bottom'
show-dock-item=true
theme='ShreeOS'
tooltips-enabled=true
zoom-enabled=true
zoom-percent=135
