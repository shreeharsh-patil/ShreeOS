#!/bin/sh
set -eu

choice="${1:-}"
if [ -z "$choice" ]; then
  choice="$(kdialog --menu 'Choose ShreeOS appearance' \
    dark 'ShreeOS Dark' light 'ShreeOS Light')" || exit 0
fi

case "$choice" in
  dark)
    scheme='ShreeOS Dark'
    gtk_theme=Breeze-Dark
    icons=Papirus-Dark
    dock_theme=ShreeOS-Glass-Dark
    dark=true
    ;;
  light)
    scheme='ShreeOS Light'
    gtk_theme=Breeze
    icons=Papirus
    dock_theme=ShreeOS-Glass
    dark=false
    ;;
  *)
    echo 'Usage: shreeos-theme [dark|light]' >&2
    exit 2
    ;;
esac

kwriteconfig6 --file kdeglobals --group Icons --key Theme "$icons"
# Debian installs this helper outside PATH. Query the package rather than
# depending on an architecture-specific libexec path.
icon_helper="$(dpkg-query -L plasma-workspace | sed -n '\|/plasma-changeicons$|p' | head -n 1)"
if [ -n "$icon_helper" ] && [ -x "$icon_helper" ]; then
  "$icon_helper" "$icons"
fi
plasma-apply-colorscheme "$scheme"
# Appearance changes preserve the user's wallpaper and dock launchers.
dconf write /net/launchpad/plank/docks/dock1/theme "'$dock_theme'"
for gtk_version in 3.0 4.0; do
  config="$HOME/.config/gtk-$gtk_version/settings.ini"
  kwriteconfig6 --file "$config" --group Settings --key gtk-theme-name "$gtk_theme"
  kwriteconfig6 --file "$config" --group Settings --key gtk-icon-theme-name "$icons"
  kwriteconfig6 --file "$config" --group Settings --key gtk-application-prefer-dark-theme "$dark"
done
kwriteconfig6 --file "$HOME/.local/share/konsole/ShreeOS.profile" \
  --group Appearance --key ColorScheme "$scheme"
notify-send 'ShreeOS appearance' "$scheme is active. Reopen GTK apps to refresh their theme."
