#!/bin/sh
set -eu

config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
marker="$config_home/shreeos/plasma-defaults-applied"
[ -e "$marker" ] && exit 0

# Applying a look-and-feel resets plasmashell.  Run the hook outside the
# Plasma autostart process so that reset cannot terminate the hook itself.
if [ "${SHREEOS_PLASMA_FIRST_LOGIN_SERVICE:-0}" != 1 ]; then
  exec systemd-run --user --quiet --no-block --collect \
    --unit=shreeos-plasma-defaults \
    --property=PartOf=graphical-session.target \
    --setenv=XDG_CONFIG_HOME="$config_home" \
    --setenv=DISPLAY="${DISPLAY:-:0}" \
    --setenv=XAUTHORITY="${XAUTHORITY:-$HOME/.Xauthority}" \
    /usr/bin/env SHREEOS_PLASMA_FIRST_LOGIN_SERVICE=1 \
    /usr/local/bin/shreeos-plasma-first-login
fi

mkdir -p "${marker%/*}"
# Wait for plasmashell to finish registering its session services before
# applying the layout. Resetting the layout during Plasma startup can terminate
# the shell before it has loaded the ShreeOS panel and dock.
sleep 10
uid="$(id -u)"
apply_attempt=0
while [ "$apply_attempt" -lt 30 ]; do
  shell_pid_before="$(pgrep -u "$uid" -x plasmashell | head -n 1 || true)"
  if plasma-apply-lookandfeel --apply org.shreeos.desktop --resetLayout; then
    break
  fi
  apply_attempt=$((apply_attempt + 1))
  sleep 1
done
if [ "$apply_attempt" -ge 30 ]; then
  logger -t shreeos-plasma-first-login 'Plasma session did not accept ShreeOS desktop defaults'
  exit 1
fi

# Plasma's resetLayout operation can stop the shell it was called from. The
# user-service drop-in restarts it. Wait for the original process to exit before
# treating a plasmashell process as ready; otherwise the wallpaper update can
# race the old shell's shutdown and be lost. The interval grows so a restart
# this quick is not preceded by a burst of one-second pgrep spawns.
shell_waited=0
shell_interval=1
if [ -n "$shell_pid_before" ]; then
  # Some Plasma versions apply the new layout without replacing the shell.
  # Give a requested restart a bounded window, but do not block first-login
  # setup if Plasma keeps the existing process.
  while [ "$shell_waited" -lt 10 ] &&
    pgrep -u "$uid" -x plasmashell | grep -Fxq "$shell_pid_before"; do
    sleep "$shell_interval"
    shell_waited=$((shell_waited + shell_interval))
    shell_interval=$((shell_interval * 2))
    [ "$shell_interval" -le 3 ] || shell_interval=3
  done
fi

shell_waited=0
shell_interval=1
while [ "$shell_waited" -lt 30 ] &&
  ! pgrep -u "$uid" -x plasmashell >/dev/null 2>&1; do
  sleep "$shell_interval"
  shell_waited=$((shell_waited + shell_interval))
  shell_interval=$((shell_interval * 2))
  [ "$shell_interval" -le 5 ] || shell_interval=5
done
if ! pgrep -u "$uid" -x plasmashell >/dev/null 2>&1; then
  logger -t shreeos-plasma-first-login 'Plasma shell did not restart after applying ShreeOS desktop defaults'
  exit 1
fi

plasma-apply-desktoptheme shreeos-glass
/usr/local/bin/shreeos-theme light

wallpaper_attempt=0
while [ "$wallpaper_attempt" -lt 30 ]; do
  if plasma-apply-wallpaperimage /usr/share/backgrounds/shreeos/shreeos-ember-flow.png; then
    break
  fi
  wallpaper_attempt=$((wallpaper_attempt + 1))
  sleep 1
done
if [ "$wallpaper_attempt" -ge 30 ]; then
  logger -t shreeos-plasma-first-login 'Plasma session did not accept the ShreeOS wallpaper'
  exit 1
fi

config="$config_home/plasma-org.kde.plasma.desktop-appletsrc"
attempt=0
while [ "$attempt" -lt 30 ]; do
  if grep -Fq 'plugin=org.kde.plasma.systemtray' "$config" &&
    grep -Fq 'plugin=org.kde.plasma.kickoff' "$config" &&
    grep -Fq 'plugin=org.kde.plasma.appmenu' "$config" &&
    grep -Fq 'plugin=org.kde.plasma.digitalclock' "$config"; then
    break
  fi
  attempt=$((attempt + 1))
  sleep 1
done
if [ "$attempt" -ge 30 ]; then
  logger -t shreeos-plasma-first-login 'Plasma did not write the ShreeOS menu bar, system tray, and clock configuration'
  exit 1
fi

# Balanced is the ShreeOS default power profile. power-profiles-daemon already
# defaults to balanced; recording it keeps the desktop, shreeos-power --status
# and the daemon in agreement without spawning a single polling process.
if command -v kwriteconfig6 >/dev/null 2>&1; then
  kwriteconfig6 --file shreeosrc --group Desktop --key PowerProfile balanced
fi

touch "$marker"
