#!/bin/sh
set -eu

# ShreeOS live boot performance probe.
#
# Runs once on live media only and writes machine-readable SHREEOS_PERF lines to
# the console, so the release pipeline can record cold-boot time, loaded
# services and the real idle RAM/CPU footprint from the serial log. This exists
# because a guest with no agent and no network can still be measured, and
# because "we changed a config" is not evidence of a resource win.
#
# Nothing here writes to the system, installs anything, or runs in an installed
# system: the unit that starts this is conditioned on the live medium.

WINDOW_SECONDS=30
DESKTOP_WAIT_SECONDS=180
SETTLE_SECONDS=15
BOOT_TOTAL_WAIT_SECONDS=180
PERFORMANCE_TIME_HELPER=/usr/local/lib/shreeos/performance-time.sh

emit() { printf 'SHREEOS_PERF %s=%s\n' "$1" "$2"; }

desktop_ready() {
  [ -r /etc/shreeos/image-profile ] || return 1
  profile="$(cat /etc/shreeos/image-profile 2>/dev/null || true)"
  case "$profile" in
    plasma)
      systemctl is-active --quiet sddm.service &&
        pgrep -u shree -x plasmashell >/dev/null &&
        pgrep -u shree -x kwin_x11 >/dev/null &&
        pgrep -u shree -x plank >/dev/null &&
        [ -f /home/shree/.config/shreeos/plasma-defaults-applied ]
      ;;
    desktop)
      systemctl is-active --quiet display-manager.service &&
        pgrep -u shree -x xfce4-session >/dev/null &&
        pgrep -u shree -x plank >/dev/null &&
        [ -f /home/shree/.config/shreeos/xfce-session-ready ]
      ;;
    *) return 1 ;;
  esac
}

# graphical.target can be reached before the display manager's user session is
# fully composed. Wait for concrete session readiness, then let the desktop
# settle before taking idle samples.
waited=0
ready=0
while [ "$waited" -lt "$DESKTOP_WAIT_SECONDS" ]; do
  if desktop_ready; then ready=1; break; fi
  sleep 2
  waited=$((waited + 2))
done
if [ "$ready" -eq 0 ] && desktop_ready; then ready=1; fi
emit desktop_ready "$ready"
emit desktop_startup_wait_s "$waited"
emit settle_window_s "$SETTLE_SECONDS"
sleep "$SETTLE_SECONDS"

to_mib() {
  # Integer MiB from KiB, rounding down; never fails on a missing value.
  case "${1:-}" in
    '' | *[!0-9]*) echo 0 ;;
    *) echo $(( $1 / 1024 )) ;;
  esac
}

to_ms() {
  shreeos_duration_to_ms "${1:-}"
}

# --- Cold boot ---------------------------------------------------------------
probe_started="$(cut -d' ' -f1 /proc/uptime)"
# The duration helpers are also used by the memory section below, so they are
# loaded whether or not systemd-analyze is available.
if [ ! -r "$PERFORMANCE_TIME_HELPER" ]; then
  emit boot_total_ms 0
  echo "Missing performance duration helper: $PERFORMANCE_TIME_HELPER" >&2
  exit 1
fi
# shellcheck source=/dev/null
. "$PERFORMANCE_TIME_HELPER"
if command -v systemd-analyze >/dev/null 2>&1; then
  summary=""
  boot_waited=0
  while [ "$boot_waited" -lt "$BOOT_TOTAL_WAIT_SECONDS" ]; do
    summary="$(LC_ALL=C systemd-analyze time 2>&1 || true)"
    case "$summary" in
      *'Startup finished in '*) break ;;
      *'Bootup is not yet finished'*)
        sleep 2
        boot_waited=$((boot_waited + 2))
        ;;
      *)
        emit boot_total_ms 0
        printf 'systemd-analyze time returned no usable boot summary: %s\n' \
          "${summary:-no output}" >&2
        exit 1
        ;;
    esac
  done
  case "$summary" in
    *'Startup finished in '*) ;;
    *)
      emit boot_total_ms 0
      printf 'System startup did not finish within %s seconds: %s\n' \
        "$BOOT_TOTAL_WAIT_SECONDS" "${summary:-no output}" >&2
      exit 1
      ;;
  esac
  if [ -n "$summary" ]; then
    firmware="$(printf '%s\n' "$summary" | sed -n 's/.*\([0-9.][^ ]*\) (\(firmware\)).*/\1/p')"
    loader="$(printf '%s\n' "$summary" | sed -n 's/.*\([0-9.][^ ]*\) (\(loader\)).*/\1/p')"
    kernel="$(printf '%s\n' "$summary" | sed -n 's/.*\([0-9.][^ ]*\) (\(kernel\)).*/\1/p')"
    userspace="$(printf '%s\n' "$summary" | sed -n 's/.*\([0-9.][^ ]*\) (\(userspace\)).*/\1/p')"
    total="$(shreeos_extract_boot_total "$summary")"
    reached="$(printf '%s\n' "$summary" | sed -n 's/.*reached after \([0-9.][^ ]*\) .*/\1/p')"
    emit boot_firmware_ms "$(to_ms "$firmware")"
    emit boot_loader_ms "$(to_ms "$loader")"
    emit boot_kernel_ms "$(to_ms "$kernel")"
    emit boot_userspace_ms "$(to_ms "$userspace")"
    boot_total_ms="$(to_ms "$total")"
    case "$boot_total_ms" in
      ''|*[!0-9]*|0)
        emit boot_total_ms 0
        echo "Could not parse a positive systemd boot duration from: $summary" >&2
        exit 1
        ;;
    esac
    emit boot_total_ms "$boot_total_ms"
    emit graphical_reached_ms "$(to_ms "$reached")"
  fi
  # The slowest units are the actionable part of a boot-time regression.
  blame="$(systemd-analyze blame --no-pager 2>/dev/null | head -n 8 | tr -s ' ' | tr '\n' ';' || true)"
  emit blame_top "${blame%;}"
fi

# --- Startup services --------------------------------------------------------
if command -v systemctl >/dev/null 2>&1; then
  running="$(systemctl list-units --type=service --state=running --no-legend --no-pager 2>/dev/null | wc -l | tr -d ' ')"
  failed="$(systemctl list-units --state=failed --no-legend --no-pager 2>/dev/null | wc -l | tr -d ' ')"
  emit services_running "$running"
  emit units_failed "$failed"
  emit units_total "$(systemctl list-units --no-legend --no-pager 2>/dev/null | wc -l | tr -d ' ')"
  emit user_units_total "$(systemctl --user list-units --no-legend --no-pager 2>/dev/null | wc -l | tr -d ' ' || echo 0)"
fi

# --- Memory ------------------------------------------------------------------
total_kib="$(shreeos_extract_meminfo_kib MemTotal)"
available_kib="$(shreeos_extract_meminfo_kib MemAvailable)"
swap_total_kib="$(shreeos_extract_meminfo_kib SwapTotal)"
swap_free_kib="$(shreeos_extract_meminfo_kib SwapFree)"
emit mem_total_mib "$(to_mib "$total_kib")"
emit mem_available_mib "$(to_mib "$available_kib")"
emit mem_used_mib "$(to_mib $(( ${total_kib:-0} - ${available_kib:-0} )))"
emit swap_total_mib "$(to_mib "$swap_total_kib")"
emit swap_used_mib "$(to_mib $(( ${swap_total_kib:-0} - ${swap_free_kib:-0} )))"

processes="$(ps -e --no-headers 2>/dev/null | wc -l | tr -d ' ')"
emit processes "$processes"

# --- The processes that actually dominate a Plasma desktop -------------------
for name in plasmashell kwin_x11 kwin_wayland sddm Xorg X plank baloo_file; do
  # Sort first, then collapse: a process name can match several PIDs, and
  # concatenating their RSS values would invent a number.
  rss="$(ps -C "$name" -o rss= 2>/dev/null | sort -n | tail -n 1 | tr -d ' ' || true)"
  if [ -n "$rss" ]; then
    emit "rss_mib_${name}" "$(to_mib "$rss")"
  fi
done

# PSS apportions shared pages across processes, which is more useful than RSS
# when comparing the components that make up a Plasma session.
pss_supported=0
for name in plasmashell kwin_x11 sddm Xorg plank baloo_file; do
  maximum=0
  for pid in $(pgrep -x "$name" 2>/dev/null || true); do
    rollup="/proc/$pid/smaps_rollup"
    [ -r "$rollup" ] || continue
    pss_supported=1
    pss="$(awk '$1 == "Pss:" { print $2; exit }' "$rollup" 2>/dev/null || true)"
    case "$pss" in ''|*[!0-9]*) continue ;; esac
    [ "$pss" -le "$maximum" ] || maximum="$pss"
  done
  emit "pss_mib_${name}" "$(to_mib "$maximum")"
done
emit pss_available "$pss_supported"

top_rss="$(ps -eo rss=,comm= --sort=-rss 2>/dev/null | head -n 5 |
  while read -r rss comm; do
    [ -n "${comm:-}" ] || continue
    printf '%s:%d ' "$comm" "$(to_mib "$rss")"
  done | sed 's/ *$//')"
emit top_rss_mib "${top_rss:-none}"

# --- Idle CPU ----------------------------------------------------------------
# Two /proc/stat samples over a fixed window. This measures the whole guest,
# which is exactly the "sustained idle CPU" figure the release target refers to.
cpu_sample() {
  awk '/^cpu / {
    total = 0
    for (field = 2; field <= 9; field++) total += $field
    # Linux reports iowait separately; waiting for storage is not CPU work.
    printf "%s %s\n", $5 + $6, total
  }' /proc/stat
}

idle_before=0
total_before=0
read -r idle_before total_before <<EOF
$(cpu_sample)
EOF
emit probe_window_s "$WINDOW_SECONDS"
sleep "$WINDOW_SECONDS"
idle_after=0
total_after=0
read -r idle_after total_after <<EOF
$(cpu_sample)
EOF

cpu_idle_pct="$(awk -v ib="$idle_before" -v tb="$total_before" \
  -v ia="$idle_after" -v ta="$total_after" 'BEGIN {
    idle = ia - ib
    total = ta - tb
    if (total <= 0) { print "0.00"; exit }
    printf "%.2f\n", (idle * 100) / total
  }')"
emit cpu_idle_pct "$cpu_idle_pct"
emit cpu_busy_pct "$(awk -v idle="$cpu_idle_pct" 'BEGIN { printf "%.2f\n", 100 - idle }')"

top_cpu="$(ps -eo pcpu=,comm= --sort=-pcpu 2>/dev/null | head -n 5 |
  while read -r pcpu comm; do
    [ -n "${comm:-}" ] || continue
    printf '%s:%s ' "$comm" "$pcpu"
  done | sed 's/ *$//')"
emit top_cpu_pct "${top_cpu:-none}"
emit probe_elapsed_s "$(awk -v start="$probe_started" -v now="$(cut -d' ' -f1 /proc/uptime)" \
  'BEGIN { printf "%.0f\n", now - start }')"

# Storage is measured only when the host harness attached its fresh, blank
# QEMU scratch disk with this exact serial. Never select a disk by size or by
# device name, and never write to an unmarked device.
storage_device=""
for serial_path in /sys/block/*/serial /sys/block/*/device/serial; do
  [ -r "$serial_path" ] || continue
  [ "$(cat "$serial_path" 2>/dev/null || true)" = SHREEOSPERF ] || continue
  block_name="${serial_path#/sys/block/}"
  block_name="${block_name%%/*}"
  candidate_device="/dev/$block_name"
  if [ -b "$candidate_device" ]; then
    storage_device="$candidate_device"
    break
  fi
done
if [ -n "$storage_device" ]; then
  storage_size_mib=64
  start_ns="$(date +%s%N)"
  dd if=/dev/zero of="$storage_device" bs=1M count="$storage_size_mib" \
    oflag=direct conv=fdatasync status=none
  end_ns="$(date +%s%N)"
  storage_write_mib_s="$(awk -v start="$start_ns" -v end="$end_ns" \
    -v size="$storage_size_mib" 'BEGIN {
      seconds = (end - start) / 1000000000
      if (seconds <= 0) exit 1
      printf "%.2f", size / seconds
    }')"
  start_ns="$(date +%s%N)"
  dd if="$storage_device" of=/dev/null bs=1M count="$storage_size_mib" \
    iflag=direct status=none
  end_ns="$(date +%s%N)"
  storage_read_mib_s="$(awk -v start="$start_ns" -v end="$end_ns" \
    -v size="$storage_size_mib" 'BEGIN {
      seconds = (end - start) / 1000000000
      if (seconds <= 0) exit 1
      printf "%.2f", size / seconds
    }')"
  emit storage_size_mib "$storage_size_mib"
  emit storage_write_mib_s "$storage_write_mib_s"
  emit storage_read_mib_s "$storage_read_mib_s"
fi

printf 'SHREEOS_PERF_END\n'
