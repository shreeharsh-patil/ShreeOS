#!/bin/sh
set -eu

log() {
  printf 'SHREEOS_BOOT_CHECK: %s\n' "$*" > /dev/console
}

fail() {
  log "FAIL: $*"
  exit 1
}

account_status="$(passwd --status shree)"
case "$account_status" in
  'shree L '*) ;;
  *)
  fail 'live account password is not locked'
    ;;
esac
log 'live account password is locked'

if ! apt-get check; then
  fail 'apt/dpkg package database check failed'
fi
log 'apt/dpkg package database is healthy'
if ! lsblk -ndo TYPE | grep -Fxq disk; then
  fail 'the live kernel did not detect the QEMU storage device'
fi
log 'block device detected'
if ! systemctl is-active --quiet NetworkManager.service; then
  fail 'NetworkManager is not active'
fi
log 'NetworkManager is active'

elapsed=0
until nmcli -t -f TYPE,STATE device status | grep -Eq '^ethernet:connected' &&
  ip route show default | grep -q '^default '; do
  if [ "$elapsed" -ge 60 ]; then
    fail 'the Ethernet interface did not receive a default route'
  fi
  sleep 1
  elapsed=$((elapsed + 1))
done
log 'Ethernet DHCP route is active'

if id -nG shree | tr ' ' '\n' | grep -Fxq sudo; then
  fail 'live account unexpectedly has sudo access'
fi
log 'live account has no sudo access'

if [ -f /etc/shreeos/image-profile ] &&
  [ "$(cat /etc/shreeos/image-profile)" = plasma ]; then
  log 'Plasma profile detected; checking SDDM and Plasma session'
  elapsed=0
  until systemctl is-active --quiet sddm.service &&
    pgrep -u shree -x plasmashell >/dev/null &&
    pgrep -u shree -x kwin_x11 >/dev/null; do
    if [ "$elapsed" -ge 90 ]; then
      ps -eo user,pid,args | grep -E '[s]ddm|[p]lasmashell|[k]win_x11' \
        | while IFS= read -r diagnostic; do log "$diagnostic"; done
      fail 'SDDM did not start a Plasma session within 90 seconds'
    fi
    sleep 1
    elapsed=$((elapsed + 1))
  done
  log 'SDDM and Plasma desktop session are active'
elif [ -f /etc/shreeos/image-profile ] &&
  [ "$(cat /etc/shreeos/image-profile)" = desktop ]; then
  log 'desktop profile detected; checking GTK runtime'
  python3 -c 'import gi; gi.require_version("Gtk", "3.0")' || {
    fail 'the ShreeOS Control Center GTK runtime is unavailable'
  }
  log 'GTK runtime is available'
  [ -x /usr/local/bin/shreeos-control-center ] || {
    fail 'the ShreeOS Control Center launcher is missing'
  }
  log 'Control Center launcher is available'
  [ -x /usr/local/bin/shreeos-search ] || {
    fail 'the ShreeOS Search launcher is missing'
  }
  log 'Search launcher is available'
  [ -x /usr/local/bin/shreeos-overview ] || {
    fail 'the Workspace Overview launcher is missing'
  }
  log 'Workspace Overview launcher is available'
  elapsed=0
  until systemctl is-active --quiet display-manager.service &&
    pgrep -u shree -x xfce4-session >/dev/null &&
    pgrep -u shree -x xfce4-panel >/dev/null &&
    pgrep -u shree -x plank >/dev/null &&
    [ -f /home/shree/.config/shreeos/xfce-session-ready ]; do
    if [ "$elapsed" -ge 60 ]; then
      log 'desktop session startup timed out; live-user process inventory:'
      ps -u shree -o pid,args | tail -n 32 \
        | while IFS= read -r diagnostic; do log "$diagnostic"; done
      log 'live-user session journal:'
      journalctl -b _UID=1000 --no-pager -n 40 2>/dev/null \
        | while IFS= read -r diagnostic; do log "$diagnostic"; done
      if [ -r /home/shree/.xsession-errors ]; then
        log 'X session error log:'
        tail -n 40 /home/shree/.xsession-errors \
          | while IFS= read -r diagnostic; do log "$diagnostic"; done
      fi
      if [ -e /home/shree/.config/shreeos/xfce-session-ready ]; then
        log 'ShreeOS first-login setup marker exists'
      else
        log 'ShreeOS first-login setup marker is missing'
      fi
      fail 'desktop session, panel, dock, or ShreeOS first-login setup did not finish within 60 seconds'
    fi
    sleep 1
    elapsed=$((elapsed + 1))
  done

  log 'display session inventory:'
  ps -eo user,pid,args | grep -E '[X]org|[X]wayland|[l]ightdm|[x]fce4-session|[x]fwm4|[x]fdesktop|[x]fce4-panel|[p]lank' | tail -n 24 \
    | while IFS= read -r diagnostic; do log "$diagnostic"; done
  log 'live user desktop processes:'
  ps -u shree -o pid,args | tail -n 24 \
    | while IFS= read -r diagnostic; do log "$diagnostic"; done
  for session_log in \
    /home/shree/.cache/shreeos-session-setup.log \
    /home/shree/.xsession-errors
  do
    if [ -r "$session_log" ]; then
      log "desktop session output from $session_log:"
      tail -n 60 "$session_log" \
        | while IFS= read -r diagnostic; do log "$diagnostic"; done
    fi
  done
  log 'desktop component journal:'
  journalctl -b _UID=1000 --no-pager 2>/dev/null \
    | grep -Ei 'xfce4-panel|xfce4-session|xfdesktop|plank|shreeos-session-setup' \
    | tail -n 40 \
    | while IFS= read -r diagnostic; do log "$diagnostic"; done
  log 'active graphical logins:'
  loginctl list-sessions --no-legend | while IFS= read -r diagnostic; do
    log "$diagnostic"
  done
  if command -v runuser >/dev/null 2>&1 && command -v xrandr >/dev/null 2>&1; then
    log 'X display :0 mode inventory:'
    if mode_inventory="$(runuser -u shree -- env DISPLAY=:0 xrandr --current 2>&1)"; then
      printf '%s\n' "$mode_inventory" \
        | grep -E '^(Screen|[[:alnum:]-]+ connected)|^[[:space:]].*[*+]' \
        | tail -n 16 | while IFS= read -r diagnostic; do log "$diagnostic"; done
    else
      log "xrandr query failed: $mode_inventory"
    fi
  fi
  if command -v runuser >/dev/null 2>&1 && command -v wmctrl >/dev/null 2>&1; then
    log 'visible X11 window inventory:'
    if window_inventory="$(runuser -u shree -- env DISPLAY=:0 wmctrl -lG 2>&1)"; then
      printf '%s\n' "$window_inventory" | tail -n 16 \
        | while IFS= read -r diagnostic; do log "$diagnostic"; done
    else
      log "wmctrl query failed: $window_inventory"
    fi
  fi
  session_pid="$(pgrep -u shree -x xfce4-session | head -n 1)"
  session_env=""
  if [ -n "$session_pid" ] && [ -r "/proc/${session_pid}/environ" ]; then
    session_env="$(tr '\000' '\n' < "/proc/${session_pid}/environ")"
  fi
  session_display="$(printf '%s\n' "$session_env" | sed -n 's/^DISPLAY=//p' | head -n 1)"
  session_bus="$(printf '%s\n' "$session_env" | sed -n 's/^DBUS_SESSION_BUS_ADDRESS=//p' | head -n 1)"
  session_runtime="$(printf '%s\n' "$session_env" | sed -n 's/^XDG_RUNTIME_DIR=//p' | head -n 1)"
  log "XFCE session environment: DISPLAY=${session_display:-unset} DBUS_SESSION_BUS_ADDRESS=${session_bus:-unset} XDG_RUNTIME_DIR=${session_runtime:-unset}"
  if command -v runuser >/dev/null 2>&1 && command -v xfconf-query >/dev/null 2>&1; then
    log 'live XFCE panel settings:'
    if panel_inventory="$(runuser -u shree -- env DISPLAY="${session_display:-:0}" \
      DBUS_SESSION_BUS_ADDRESS="$session_bus" XDG_RUNTIME_DIR="$session_runtime" \
      xfconf-query -c xfce4-panel -lv 2>&1)"; then
      printf '%s\n' "$panel_inventory" | tail -n 32 \
        | while IFS= read -r diagnostic; do log "$diagnostic"; done
    else
      log "panel configuration query failed: $panel_inventory"
    fi
  fi
  if command -v runuser >/dev/null 2>&1 && command -v xwininfo >/dev/null 2>&1; then
    log 'X11 root window tree:'
    if x_window_tree="$(runuser -u shree -- env DISPLAY="${session_display:-:0}" xwininfo -root -tree 2>&1)"; then
      printf '%s\n' "$x_window_tree" | tail -n 32 \
        | while IFS= read -r diagnostic; do log "$diagnostic"; done
    else
      log "X11 window tree query failed: $x_window_tree"
    fi
  fi
  if command -v runuser >/dev/null 2>&1 && command -v xset >/dev/null 2>&1; then
    log 'X11 screensaver and DPMS state:'
    if screensaver_state="$(runuser -u shree -- env DISPLAY="${session_display:-:0}" xset q 2>&1)"; then
      printf '%s\n' "$screensaver_state" \
        | grep -E 'timeout:|prefer blanking:|DPMS is|Standby:|Suspend:|Off:' \
        | while IFS= read -r diagnostic; do log "$diagnostic"; done
    else
      log "X11 screensaver query failed: $screensaver_state"
    fi
  fi
  for xorg_log in /var/log/Xorg.0.log /var/log/lightdm/x-0.log; do
    if [ -r "$xorg_log" ]; then
      log "X11 server details from $xorg_log:"
      grep -E 'Loading.*driver|modeset|virtio|Virtual-1|connected|\(EE\)|\(WW\)' "$xorg_log" \
        | tail -n 24 | while IFS= read -r diagnostic; do log "$diagnostic"; done
    fi
  done
  if command -v runuser >/dev/null 2>&1 && command -v xfconf-query >/dev/null 2>&1; then
    log 'XFCE desktop backdrop configuration:'
    if backdrop_inventory="$(runuser -u shree -- env DISPLAY="${session_display:-:0}" \
      DBUS_SESSION_BUS_ADDRESS="$session_bus" XDG_RUNTIME_DIR="$session_runtime" \
      xfconf-query -c xfce4-desktop -lv 2>&1)"; then
      printf '%s\n' "$backdrop_inventory" | tail -n 16 \
        | while IFS= read -r diagnostic; do log "$diagnostic"; done
    else
      log "xfconf query failed: $backdrop_inventory"
    fi
  fi
  for desktop_config in \
    /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-panel.xml \
    /home/shree/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-panel.xml \
    /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-desktop.xml \
    /home/shree/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-desktop.xml
  do
    if [ -r "$desktop_config" ]; then
      log "XFCE config values from $desktop_config:"
      grep -E 'panel-1|length|size|position|last-image|image-style' "$desktop_config" \
        | tail -n 12 | while IFS= read -r diagnostic; do log "$diagnostic"; done
    else
      log "XFCE config missing: $desktop_config"
    fi
  done
  journalctl -b -u lightdm.service --no-pager -n 40 2>/dev/null \
    | while IFS= read -r diagnostic; do log "LightDM: $diagnostic"; done

  find /var/log /home/shree -type f \
    \( -iname 'Xorg*.log' -o -iname 'x-*.log' -o -iname '*lightdm*.log' \) \
    -exec grep -HnEi '\(EE\)|fatal server error|no screens found|failed to|cannot open /dev/dri' {} + \
    | tail -n 24 | while IFS= read -r diagnostic; do
      log "display log: $diagnostic"
    done
fi

log 'all live boot checks passed'
echo SHREEOS_LIVE_BOOT_OK > /dev/console
