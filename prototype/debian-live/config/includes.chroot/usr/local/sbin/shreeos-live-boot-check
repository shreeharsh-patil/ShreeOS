#!/bin/sh
set -eu

account_status="$(passwd --status shree)"
case "$account_status" in
  'shree L '*) ;;
  *)
  echo 'ShreeOS live account password is not locked.' >&2
  exit 1
    ;;
esac

apt-get check
if ! lsblk -ndo TYPE | grep -Fxq disk; then
  echo 'The live kernel did not detect the QEMU storage device.' >&2
  exit 1
fi
if ! systemctl is-active --quiet NetworkManager.service; then
  echo 'NetworkManager is not active in the live system.' >&2
  exit 1
fi

elapsed=0
until nmcli -t -f TYPE,STATE device status | grep -Eq '^ethernet:connected' &&
  ip route show default | grep -q '^default '; do
  if [ "$elapsed" -ge 60 ]; then
    echo 'The QEMU Ethernet interface did not receive a default route.' >&2
    exit 1
  fi
  sleep 1
  elapsed=$((elapsed + 1))
done

if id -nG shree | tr ' ' '\n' | grep -Fxq sudo; then
  echo 'ShreeOS console live account unexpectedly has sudo access.' >&2
  exit 1
fi

if [ -f /etc/shreeos/image-profile ] &&
  [ "$(cat /etc/shreeos/image-profile)" = desktop ]; then
  python3 -c 'import gi; gi.require_version("Gtk", "3.0")' || {
    echo 'The ShreeOS Control Center GTK runtime is unavailable.' >&2
    exit 1
  }
  [ -x /usr/local/bin/shreeos-control-center ] || {
    echo 'The ShreeOS Control Center launcher is missing.' >&2
    exit 1
  }
  [ -x /usr/local/bin/shreeos-search ] || {
    echo 'The ShreeOS Search launcher is missing.' >&2
    exit 1
  }
  elapsed=0
  until systemctl is-active --quiet display-manager.service &&
    pgrep -u shree -x xfce4-session >/dev/null &&
    pgrep -u shree -x xfce4-panel >/dev/null &&
    pgrep -u shree -x plank >/dev/null; do
    if [ "$elapsed" -ge 120 ]; then
      echo 'ShreeOS desktop session, panel, or dock did not start within 120 seconds.' >&2
      exit 1
    fi
    sleep 1
    elapsed=$((elapsed + 1))
  done
fi

echo SHREEOS_LIVE_BOOT_OK > /dev/console
